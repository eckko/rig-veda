   "010.170.1a",
   "010.170.1b"
  ],
  "lines_deva": [
   "वि॒भ्राड्बृ॒हत्पि॑बतु सो॒म्यं मध्वायु॒र्दध॑द्य॒ज्ञप॑ता॒ववि॑ह्रुतम्",
   "वात॑जूतो॒ यो अ॑भि॒रक्ष॑ति॒ त्मना॑ प्र॒जाः पु॑पोष पुरु॒धा वि रा॑जति"
  ],
  "lines_iast": [
   "vi̱bhrāḍbṛ̱hatpi̭batu so̱myaṃ madhvāyu̱rdadha̭dya̱jñapa̭tā̱vavi̭hrutam",
   "vāta̭jūto̱ yo a̭bhi̱rakṣa̭ti̱ tmanā̭ pra̱jāḥ pṷpoṣa puru̱dhā vi rā̭jati"
  ],

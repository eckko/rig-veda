 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "010.170.4a",
   "010.170.4b"
  ],
  "lines_deva": [
   "वि॒भ्राज॒ञ्ज्योति॑षा॒ स्व१रग॑च्छो रोच॒नं दि॒वः",
   "येने॒मा विश्वा॒ भुव॑ना॒न्याभृ॑ता वि॒श्वक॑र्मणा वि॒श्वदे॑व्यावता"
  ],
  "lines_iast": [
   "vi̱bhrāja̱ñjyoti̭ṣā̱ sva1raga̭ccho roca̱naṃ di̱vaḥ",
   "yene̱mā viśvā̱ bhuva̭nā̱nyābhṛ̭tā vi̱śvaka̭rmaṇā vi̱śvadḙvyāvatā"
  ],

 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "010.170.2a",
   "010.170.2b"
  ],
  "lines_deva": [
   "वि॒भ्राड्बृ॒हत्सुभृ॑तं वाज॒सात॑मं॒ धर्म॑न्दि॒वो ध॒रुणे॑ स॒त्यमर्पि॑तम्",
   "अ॒मि॒त्र॒हा वृ॑त्र॒हा द॑स्यु॒हन्त॑मं॒ ज्योति॑र्जज्ञे असुर॒हा स॑पत्न॒हा"
  ],
  "lines_iast": [
   "vi̱bhrāḍbṛ̱hatsubhṛ̭taṃ vāja̱sāta̭ma̱ṃ dharma̭ndi̱vo dha̱ruṇḙ sa̱tyamarpi̭tam",
   "a̱mi̱tra̱hā vṛ̭tra̱hā da̭syu̱hanta̭ma̱ṃ jyoti̭rjajñe asura̱hā sa̭patna̱hā"
  ],

   "010.140.1a",
   "010.140.1b"
  ],
  "lines_deva": [
   "अग्ने॒ तव॒ श्रवो॒ वयो॒ महि॑ भ्राजन्ते अ॒र्चयो॑ विभावसो",
   "बृह॑द्भानो॒ शव॑सा॒ वाज॑मु॒क्थ्यं१ दधा॑सि दा॒शुषे॑ कवे"
  ],
  "lines_iast": [
   "agne̱ tava̱ śravo̱ vayo̱ mahi̭ bhrājante a̱rcayo̭ vibhāvaso",
   "bṛha̭dbhāno̱ śava̭sā̱ vāja̭mu̱kthyaṃ1 dadhā̭si dā̱śuṣḙ kave"
  ],

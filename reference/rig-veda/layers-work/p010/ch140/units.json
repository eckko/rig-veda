   "010.140.6b"
  ],
  "lines_deva": [
   "ऋ॒तावा॑नं महि॒षं वि॒श्वद॑र्शतम॒ग्निं सु॒म्नाय॑ दधिरे पु॒रो जना॑:",
   "श्रुत्क॑र्णं स॒प्रथ॑स्तमं त्वा गि॒रा दैव्यं॒ मानु॑षा यु॒गा"
  ],
  "lines_iast": [
   "ṛ̱tāvā̭naṃ mahi̱ṣaṃ vi̱śvada̭rśatama̱gniṃ su̱mnāya̭ dadhire pu̱ro janā̭:",
   "śrutka̭rṇaṃ sa̱pratha̭stamaṃ tvā gi̱rā daivya̱ṃ mānṷṣā yu̱gā"
  ],

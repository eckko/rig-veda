   "010.140.5b"
  ],
  "lines_deva": [
   "इ॒ष्क॒र्तार॑मध्व॒रस्य॒ प्रचे॑तसं॒ क्षय॑न्तं॒ राध॑सो म॒हः",
   "रा॒तिं वा॒मस्य॑ सु॒भगां॑ म॒हीमिषं॒ दधा॑सि सान॒सिं र॒यिम्"
  ],
  "lines_iast": [
   "i̱ṣka̱rtāra̭madhva̱rasya̱ pracḙtasa̱ṃ kṣaya̭nta̱ṃ rādha̭so ma̱haḥ",
   "rā̱tiṃ vā̱masya̭ su̱bhagā̭ṃ ma̱hīmiṣa̱ṃ dadhā̭si sāna̱siṃ ra̱yim"
  ],

 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "010.140.3a",
   "010.140.3b"
  ],
  "lines_deva": [
   "ऊर्जो॑ नपाज्जातवेदः सुश॒स्तिभि॒र्मन्द॑स्व धी॒तिभि॑र्हि॒तः",
   "त्वे इष॒: सं द॑धु॒र्भूरि॑वर्पसश्चि॒त्रोत॑यो वा॒मजा॑ताः"
  ],
  "lines_iast": [
   "ūrjo̭ napājjātavedaḥ suśa̱stibhi̱rmanda̭sva dhī̱tibhi̭rhi̱taḥ",
   "tve iṣa̱: saṃ da̭dhu̱rbhūri̭varpasaści̱trota̭yo vā̱majā̭tāḥ"
  ],

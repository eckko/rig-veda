 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "010.140.4a",
   "010.140.4b"
  ],
  "lines_deva": [
   "इ॒र॒ज्यन्न॑ग्ने प्रथयस्व ज॒न्तुभि॑र॒स्मे रायो॑ अमर्त्य",
   "स द॑र्श॒तस्य॒ वपु॑षो॒ वि रा॑जसि पृ॒णक्षि॑ सान॒सिं क्रतु॑म्"
  ],
  "lines_iast": [
   "i̱ra̱jyanna̭gne prathayasva ja̱ntubhi̭ra̱sme rāyo̭ amartya",
   "sa da̭rśa̱tasya̱ vapṷṣo̱ vi rā̭jasi pṛ̱ṇakṣi̭ sāna̱siṃ kratṷm"
  ],

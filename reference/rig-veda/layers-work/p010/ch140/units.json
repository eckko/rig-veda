 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "010.140.2a",
   "010.140.2b"
  ],
  "lines_deva": [
   "पा॒व॒कव॑र्चाः शु॒क्रव॑र्चा॒ अनू॑नवर्चा॒ उदि॑यर्षि भा॒नुना॑",
   "पु॒त्रो मा॒तरा॑ वि॒चर॒न्नुपा॑वसि पृ॒णक्षि॒ रोद॑सी उ॒भे"
  ],
  "lines_iast": [
   "pā̱va̱kava̭rcāḥ śu̱krava̭rcā̱ anṷ̄navarcā̱ udi̭yarṣi bhā̱nunā̭",
   "pu̱tro mā̱tarā̭ vi̱cara̱nnupā̭vasi pṛ̱ṇakṣi̱ roda̭sī u̱bhe"
  ],

  "lines_deva": [
   "ई॒ङ्खय॑न्तीरप॒स्युव॒ इन्द्रं॑ जा॒तमुपा॑सते । भे॒जा॒नास॑: सु॒वीर्य॑म्"
  ],
  "lines_iast": [
   "ī̱ṅkhaya̭ntīrapa̱syuva̱ indra̭ṃ jā̱tamupā̭sate | bhe̱jā̱nāsa̭: su̱vīrya̭m"
  ],

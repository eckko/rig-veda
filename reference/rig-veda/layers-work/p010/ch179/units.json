  "lines_deva": [
   "उत्ति॑ष्ठ॒ताव॑ पश्य॒तेन्द्र॑स्य भा॒गमृ॒त्विय॑म्",
   "यदि॑ श्रा॒तो जु॒होत॑न॒ यद्यश्रा॑तो मम॒त्तन॑"
  ],
  "lines_iast": [
   "utti̭ṣṭha̱tāva̭ paśya̱tendra̭sya bhā̱gamṛ̱tviya̭m",
   "yadi̭ śrā̱to ju̱hota̭na̱ yadyaśrā̭to mama̱ttana̭"
  ],

 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "010.179.2a",
   "010.179.2b"
  ],
  "lines_deva": [
   "श्रा॒तं ह॒विरो ष्वि॑न्द्र॒ प्र या॑हि ज॒गाम॒ सूरो॒ अध्व॑नो॒ विम॑ध्यम्",
   "परि॑ त्वासते नि॒धिभि॒: सखा॑यः कुल॒पा न व्रा॒जप॑तिं॒ चर॑न्तम्"
  ],
  "lines_iast": [
   "śrā̱taṃ ha̱viro ṣvi̭ndra̱ pra yā̭hi ja̱gāma̱ sūro̱ adhva̭no̱ vima̭dhyam",
   "pari̭ tvāsate ni̱dhibhi̱: sakhā̭yaḥ kula̱pā na vrā̱japa̭ti̱ṃ cara̭ntam"
  ],

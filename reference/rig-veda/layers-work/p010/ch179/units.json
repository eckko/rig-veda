 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "010.179.3a",
   "010.179.3b"
  ],
  "lines_deva": [
   "श्रा॒तं म॑न्य॒ ऊध॑नि श्रा॒तम॒ग्नौ सुश्रा॑तं मन्ये॒ तदृ॒तं नवी॑यः",
   "माध्यं॑दिनस्य॒ सव॑नस्य द॒ध्नः पिबे॑न्द्र वज्रिन्पुरुकृज्जुषा॒णः"
  ],
  "lines_iast": [
   "śrā̱taṃ ma̭nya̱ ūdha̭ni śrā̱tama̱gnau suśrā̭taṃ manye̱ tadṛ̱taṃ navī̭yaḥ",
   "mādhya̭ṃdinasya̱ sava̭nasya da̱dhnaḥ pibḙndra vajrinpurukṛjjuṣā̱ṇaḥ"
  ],

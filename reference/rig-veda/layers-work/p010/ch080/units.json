 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "010.080.4a",
   "010.080.4b"
  ],
  "lines_deva": [
   "अ॒ग्निर्दा॒द्द्रवि॑णं वी॒रपे॑शा अ॒ग्निॠषिं॒ यः स॒हस्रा॑ स॒नोति॑",
   "अ॒ग्निर्दि॒वि ह॒व्यमा त॑ताना॒ऽग्नेर्धामा॑नि॒ विभृ॑ता पुरु॒त्रा"
  ],
  "lines_iast": [
   "a̱gnirdā̱ddravi̭ṇaṃ vī̱rapḙśā a̱gniṝṣi̱ṃ yaḥ sa̱hasrā̭ sa̱noti̭",
   "a̱gnirdi̱vi ha̱vyamā ta̭tānā̱'gnerdhāmā̭ni̱ vibhṛ̭tā puru̱trā"
  ],

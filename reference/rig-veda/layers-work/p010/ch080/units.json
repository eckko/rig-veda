 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "010.080.5a",
   "010.080.5b"
  ],
  "lines_deva": [
   "अ॒ग्निमु॒क्थैॠष॑यो॒ वि ह्व॑यन्ते॒ऽग्निं नरो॒ याम॑नि बाधि॒तास॑:",
   "अ॒ग्निं वयो॑ अ॒न्तरि॑क्षे॒ पत॑न्तो॒ऽग्निः स॒हस्रा॒ परि॑ याति॒ गोना॑म्"
  ],
  "lines_iast": [
   "a̱gnimu̱kthaiṝṣa̭yo̱ vi hva̭yante̱'gniṃ naro̱ yāma̭ni bādhi̱tāsa̭:",
   "a̱gniṃ vayo̭ a̱ntari̭kṣe̱ pata̭nto̱'gniḥ sa̱hasrā̱ pari̭ yāti̱ gonā̭m"
  ],

   "010.080.7a",
   "010.080.7b"
  ],
  "lines_deva": [
   "अ॒ग्नये॒ ब्रह्म॑ ऋ॒भव॑स्ततक्षुर॒ग्निं म॒हाम॑वोचामा सुवृ॒क्तिम्",
   "अग्ने॒ प्राव॑ जरि॒तारं॑ यवि॒ष्ठाऽग्ने॒ महि॒ द्रवि॑ण॒मा य॑जस्व"
  ],
  "lines_iast": [
   "a̱gnaye̱ brahma̭ ṛ̱bhava̭statakṣura̱gniṃ ma̱hāma̭vocāmā suvṛ̱ktim",
   "agne̱ prāva̭ jari̱tāra̭ṃ yavi̱ṣṭhā'gne̱ mahi̱ dravi̭ṇa̱mā ya̭jasva"
  ],

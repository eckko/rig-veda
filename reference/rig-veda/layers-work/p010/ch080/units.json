 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "010.080.6a",
   "010.080.6b"
  ],
  "lines_deva": [
   "अ॒ग्निं विश॑ ईळते॒ मानु॑षी॒र्या अ॒ग्निं मनु॑षो॒ नहु॑षो॒ वि जा॒ताः",
   "अ॒ग्निर्गान्ध॑र्वीं प॒थ्या॑मृ॒तस्या॒ऽग्नेर्गव्यू॑तिर्घृ॒त आ निष॑त्ता"
  ],
  "lines_iast": [
   "a̱gniṃ viśa̭ īḻate̱ mānṷṣī̱ryā a̱gniṃ manṷṣo̱ nahṷṣo̱ vi jā̱tāḥ",
   "a̱gnirgāndha̭rvīṃ pa̱thyā̭mṛ̱tasyā̱'gnergavyṷ̄tirghṛ̱ta ā niṣa̭ttā"
  ],

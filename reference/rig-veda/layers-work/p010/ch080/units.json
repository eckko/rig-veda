 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "010.080.3a",
   "010.080.3b"
  ],
  "lines_deva": [
   "अ॒ग्निर्ह॒ त्यं जर॑त॒: कर्ण॑मावा॒ऽग्निर॒द्भ्यो निर॑दह॒ज्जरू॑थम्",
   "अ॒ग्निरत्रिं॑ घ॒र्म उ॑रुष्यद॒न्तर॒ग्निर्नृ॒मेधं॑ प्र॒जया॑सृज॒त्सम्"
  ],
  "lines_iast": [
   "a̱gnirha̱ tyaṃ jara̭ta̱: karṇa̭māvā̱'gnira̱dbhyo nira̭daha̱jjarṷ̄tham",
   "a̱gniratri̭ṃ gha̱rma ṷruṣyada̱ntara̱gnirnṛ̱medha̭ṃ pra̱jayā̭sṛja̱tsam"
  ],
  "book_split": [

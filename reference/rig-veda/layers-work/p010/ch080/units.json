 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "010.080.2a",
   "010.080.2b"
  ],
  "lines_deva": [
   "अ॒ग्नेरप्न॑सः स॒मिद॑स्तु भ॒द्राऽग्निर्म॒ही रोद॑सी॒ आ वि॑वेश",
   "अ॒ग्निरेकं॑ चोदयत्स॒मत्स्व॒ग्निर्वृ॒त्राणि॑ दयते पु॒रूणि॑"
  ],
  "lines_iast": [
   "a̱gnerapna̭saḥ sa̱mida̭stu bha̱drā'gnirma̱hī roda̭sī̱ ā vi̭veśa",
   "a̱gnireka̭ṃ codayatsa̱matsva̱gnirvṛ̱trāṇi̭ dayate pu̱rūṇi̭"
  ],
  "book_split": [

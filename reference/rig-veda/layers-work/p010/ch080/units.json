[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "010.080.1a",
   "010.080.1b"
  ],
  "lines_deva": [
   "अ॒ग्निः सप्तिं॑ वाजम्भ॒रं द॑दात्य॒ग्निर्वी॒रं श्रुत्यं॑ कर्मनि॒ष्ठाम्",
   "अ॒ग्नी रोद॑सी॒ वि च॑रत्सम॒ञ्जन्न॒ग्निर्नारीं॑ वी॒रकु॑क्षिं॒ पुरं॑धिम्"
  ],
  "lines_iast": [
   "a̱gniḥ sapti̭ṃ vājambha̱raṃ da̭dātya̱gnirvī̱raṃ śrutya̭ṃ karmani̱ṣṭhām",
   "a̱gnī roda̭sī̱ vi ca̭ratsama̱ñjanna̱gnirnārī̭ṃ vī̱rakṷkṣi̱ṃ pura̭ṃdhim"
  ],
  "book_split": [

[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "010.102.1a",
   "010.102.1b"
  ],
  "lines_deva": [
   "प्र ते॒ रथं॑ मिथू॒कृत॒मिन्द्रो॑ऽवतु धृष्णु॒या",
   "अ॒स्मिन्ना॒जौ पु॑रुहूत श्र॒वाय्ये॑ धनभ॒क्षेषु॑ नोऽव"
  ],
  "lines_iast": [
   "pra te̱ ratha̭ṃ mithū̱kṛta̱mindro̭'vatu dhṛṣṇu̱yā",
   "a̱sminnā̱jau pṷruhūta śra̱vāyyḙ dhanabha̱kṣeṣṷ no'va"
  ],
  "book_split": [

   "010.102.5b"
  ],
  "lines_deva": [
   "न्य॑क्रन्दयन्नुप॒यन्त॑ एन॒ममे॑हयन्वृष॒भं मध्य॑ आ॒जेः",
   "तेन॒ सूभ॑र्वं श॒तव॑त्स॒हस्रं॒ गवां॒ मुद्ग॑लः प्र॒धने॑ जिगाय"
  ],
  "lines_iast": [
   "nya̭krandayannupa̱yanta̭ ena̱mamḙhayanvṛṣa̱bhaṃ madhya̭ ā̱jeḥ",
   "tena̱ sūbha̭rvaṃ śa̱tava̭tsa̱hasra̱ṃ gavā̱ṃ mudga̭laḥ pra̱dhanḙ jigāya"
  ],

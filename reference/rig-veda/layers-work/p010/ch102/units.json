   "010.102.8b"
  ],
  "lines_deva": [
   "शु॒नम॑ष्ट्रा॒व्य॑चरत्कप॒र्दी व॑र॒त्रायां॒ दार्वा॒नह्य॑मानः",
   "नृ॒म्णानि॑ कृ॒ण्वन्ब॒हवे॒ जना॑य॒ गाः प॑स्पशा॒नस्तवि॑षीरधत्त"
  ],
  "lines_iast": [
   "śu̱nama̭ṣṭrā̱vya̭caratkapa̱rdī va̭ra̱trāyā̱ṃ dārvā̱nahya̭mānaḥ",
   "nṛ̱mṇāni̭ kṛ̱ṇvanba̱have̱ janā̭ya̱ gāḥ pa̭spaśā̱nastavi̭ṣīradhatta"
  ],

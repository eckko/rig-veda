  "lines_deva": [
   "प॒रि॒वृ॒क्तेव॑ पति॒विद्य॑मान॒ट् पीप्या॑ना॒ कूच॑क्रेणेव सि॒ञ्चन्",
   "ए॒षै॒ष्या॑ चिद्र॒थ्या॑ जयेम सुम॒ङ्गलं॒ सिन॑वदस्तु सा॒तम्"
  ],
  "lines_iast": [
   "pa̱ri̱vṛ̱kteva̭ pati̱vidya̭māna̱ṭ pīpyā̭nā̱ kūca̭kreṇeva si̱ñcan",
   "e̱ṣai̱ṣyā̭ cidra̱thyā̭ jayema suma̱ṅgala̱ṃ sina̭vadastu sā̱tam"
  ],

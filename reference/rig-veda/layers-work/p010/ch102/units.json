   "010.102.10b"
  ],
  "lines_deva": [
   "आ॒रे अ॒घा को न्वि१त्था द॑दर्श॒ यं यु॒ञ्जन्ति॒ तम्वा स्था॑पयन्ति",
   "नास्मै॒ तृणं॒ नोद॒कमा भ॑र॒न्त्युत्त॑रो धु॒रो व॑हति प्र॒देदि॑शत्"
  ],
  "lines_iast": [
   "ā̱re a̱ghā ko nvi1tthā da̭darśa̱ yaṃ yu̱ñjanti̱ tamvā sthā̭payanti",
   "nāsmai̱ tṛṇa̱ṃ noda̱kamā bha̭ra̱ntyutta̭ro dhu̱ro va̭hati pra̱dedi̭śat"
  ],

   "010.102.6b"
  ],
  "lines_deva": [
   "क॒कर्द॑वे वृष॒भो यु॒क्त आ॑सी॒दवा॑वची॒त्सार॑थिरस्य के॒शी",
   "दुधे॑र्यु॒क्तस्य॒ द्रव॑तः स॒हान॑स ऋ॒च्छन्ति॑ ष्मा नि॒ष्पदो॑ मुद्ग॒लानी॑म्"
  ],
  "lines_iast": [
   "ka̱karda̭ve vṛṣa̱bho yu̱kta ā̭sī̱davā̭vacī̱tsāra̭thirasya ke̱śī",
   "dudhḙryu̱ktasya̱ drava̭taḥ sa̱hāna̭sa ṛ̱cchanti̭ ṣmā ni̱ṣpado̭ mudga̱lānī̭m"
  ],

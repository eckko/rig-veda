  "lines_deva": [
   "इ॒मं तं प॑श्य वृष॒भस्य॒ युञ्जं॒ काष्ठा॑या॒ मध्ये॑ द्रुघ॒णं शया॑नम्",
   "येन॑ जि॒गाय॑ श॒तव॑त्स॒हस्रं॒ गवां॒ मुद्ग॑लः पृत॒नाज्ये॑षु"
  ],
  "lines_iast": [
   "i̱maṃ taṃ pa̭śya vṛṣa̱bhasya̱ yuñja̱ṃ kāṣṭhā̭yā̱ madhyḙ drugha̱ṇaṃ śayā̭nam",
   "yena̭ ji̱gāya̭ śa̱tava̭tsa̱hasra̱ṃ gavā̱ṃ mudga̭laḥ pṛta̱nājyḙṣu"
  ],

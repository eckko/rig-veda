   "010.102.3b"
  ],
  "lines_deva": [
   "अ॒न्तर्य॑च्छ॒ जिघां॑सतो॒ वज्र॑मिन्द्राभि॒दास॑तः",
   "दास॑स्य वा मघव॒न्नार्य॑स्य वा सनु॒तर्य॑वया व॒धम्"
  ],
  "lines_iast": [
   "a̱ntarya̭ccha̱ jighā̭ṃsato̱ vajra̭mindrābhi̱dāsa̭taḥ",
   "dāsa̭sya vā maghava̱nnārya̭sya vā sanu̱tarya̭vayā va̱dham"
  ],
  "book_split": [

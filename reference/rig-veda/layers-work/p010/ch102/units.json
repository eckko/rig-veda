   "010.102.4a",
   "010.102.4b"
  ],
  "lines_deva": [
   "उ॒द्नो ह्र॒दम॑पिब॒ज्जर्हृ॑षाण॒: कूटं॑ स्म तृं॒हद॒भिमा॑तिमेति",
   "प्र मु॒ष्कभा॑र॒: श्रव॑ इ॒च्छमा॑नोऽजि॒रं बा॒हू अ॑भर॒त्सिषा॑सन्"
  ],
  "lines_iast": [
   "u̱dno hra̱dama̭piba̱jjarhṛ̭ṣāṇa̱: kūṭa̭ṃ sma tṛ̱ṃhada̱bhimā̭timeti",
   "pra mu̱ṣkabhā̭ra̱: śrava̭ i̱cchamā̭no'ji̱raṃ bā̱hū a̭bhara̱tsiṣā̭san"
  ],

  "lines_deva": [
   "त्वं विश्व॑स्य॒ जग॑त॒श्चक्षु॑रिन्द्रासि॒ चक्षु॑षः । वृषा॒ यदा॒जिं वृष॑णा॒ सिषा॑ससि चो॒दय॒न्वध्रि॑णा यु॒जा"
  ],
  "lines_iast": [
   "tvaṃ viśva̭sya̱ jaga̭ta̱ścakṣṷrindrāsi̱ cakṣṷṣaḥ | vṛṣā̱ yadā̱jiṃ vṛṣa̭ṇā̱ siṣā̭sasi co̱daya̱nvadhri̭ṇā yu̱jā"
  ],

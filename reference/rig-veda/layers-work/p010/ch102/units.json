 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "010.102.2a",
   "010.102.2b"
  ],
  "lines_deva": [
   "उत्स्म॒ वातो॑ वहति॒ वासो॑ऽस्या॒ अधि॑रथं॒ यदज॑यत्स॒हस्र॑म्",
   "र॒थीर॑भून्मुद्ग॒लानी॒ गवि॑ष्टौ॒ भरे॑ कृ॒तं व्य॑चेदिन्द्रसे॒ना"
  ],
  "lines_iast": [
   "utsma̱ vāto̭ vahati̱ vāso̭'syā̱ adhi̭ratha̱ṃ yadaja̭yatsa̱hasra̭m",
   "ra̱thīra̭bhūnmudga̱lānī̱ gavi̭ṣṭau̱ bharḙ kṛ̱taṃ vya̭cedindrase̱nā"
  ],
  "book_split": [

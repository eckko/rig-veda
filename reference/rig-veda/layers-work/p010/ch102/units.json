  "lines_deva": [
   "उ॒त प्र॒धिमुद॑हन्नस्य वि॒द्वानुपा॑युन॒ग्वंस॑ग॒मत्र॒ शिक्ष॑न्",
   "इन्द्र॒ उदा॑व॒त्पति॒मघ्न्या॑ना॒मरं॑हत॒ पद्या॑भिः क॒कुद्मा॑न्"
  ],
  "lines_iast": [
   "u̱ta pra̱dhimuda̭hannasya vi̱dvānupā̭yuna̱gvaṃsa̭ga̱matra̱ śikṣa̭n",
   "indra̱ udā̭va̱tpati̱maghnyā̭nā̱mara̭ṃhata̱ padyā̭bhiḥ ka̱kudmā̭n"
  ],

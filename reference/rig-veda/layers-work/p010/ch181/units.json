 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "010.181.3a",
   "010.181.3b"
  ],
  "lines_deva": [
   "ते॑ऽविन्द॒न्मन॑सा॒ दीध्या॑ना॒ यजु॑: ष्क॒न्नं प्र॑थ॒मं दे॑व॒यान॑म्",
   "धा॒तुर्द्युता॑नात्सवि॒तुश्च॒ विष्णो॒रा सूर्या॑दभरन्घ॒र्ममे॒ते"
  ],
  "lines_iast": [
   "tḙ'vinda̱nmana̭sā̱ dīdhyā̭nā̱ yajṷ: ṣka̱nnaṃ pra̭tha̱maṃ dḙva̱yāna̭m",
   "dhā̱turdyutā̭nātsavi̱tuśca̱ viṣṇo̱rā sūryā̭dabharangha̱rmame̱te"
  ],

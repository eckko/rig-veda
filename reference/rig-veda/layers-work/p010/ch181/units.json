   "010.181.1b"
  ],
  "lines_deva": [
   "प्रथ॑श्च॒ यस्य॑ स॒प्रथ॑श्च॒ नामाऽऽनु॑ष्टुभस्य ह॒विषो॑ ह॒विर्यत्",
   "धा॒तुर्द्युता॑नात्सवि॒तुश्च॒ विष्णो॑ रथंत॒रमा ज॑भारा॒ वसि॑ष्ठः"
  ],
  "lines_iast": [
   "pratha̭śca̱ yasya̭ sa̱pratha̭śca̱ nāmā''nṷṣṭubhasya ha̱viṣo̭ ha̱viryat",
   "dhā̱turdyutā̭nātsavi̱tuśca̱ viṣṇo̭ rathaṃta̱ramā ja̭bhārā̱ vasi̭ṣṭhaḥ"
  ],

 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "010.181.2a",
   "010.181.2b"
  ],
  "lines_deva": [
   "अवि॑न्द॒न्ते अति॑हितं॒ यदासी॑द्य॒ज्ञस्य॒ धाम॑ पर॒मं गुहा॒ यत्",
   "धा॒तुर्द्युता॑नात्सवि॒तुश्च॒ विष्णो॑र्भ॒रद्वा॑जो बृ॒हदा च॑क्रे अ॒ग्नेः"
  ],
  "lines_iast": [
   "avi̭nda̱nte ati̭hita̱ṃ yadāsī̭dya̱jñasya̱ dhāma̭ para̱maṃ guhā̱ yat",
   "dhā̱turdyutā̭nātsavi̱tuśca̱ viṣṇo̭rbha̱radvā̭jo bṛ̱hadā ca̭kre a̱gneḥ"
  ],

  "lines_deva": [
   "यम॑ग्ने॒ मन्य॑से र॒यिं सह॑सावन्नमर्त्य",
   "तमा नो॒ वाज॑सातये॒ वि वो॒ मदे॑ य॒ज्ञेषु॑ चि॒त्रमा भ॑रा॒ विव॑क्षसे"
  ],
  "lines_iast": [
   "yama̭gne̱ manya̭se ra̱yiṃ saha̭sāvannamartya",
   "tamā no̱ vāja̭sātaye̱ vi vo̱ madḙ ya̱jñeṣṷ ci̱tramā bha̭rā̱ viva̭kṣase"
  ],

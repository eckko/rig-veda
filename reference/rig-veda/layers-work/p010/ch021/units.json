  "lines_deva": [
   "त्वामु॒ ते स्वा॒भुव॑: शु॒म्भन्त्यश्व॑राधसः",
   "वेति॒ त्वामु॑प॒सेच॑नी॒ वि वो॒ मद॒ ऋजी॑तिरग्न॒ आहु॑ति॒र्विव॑क्षसे"
  ],
  "lines_iast": [
   "tvāmu̱ te svā̱bhuva̭: śu̱mbhantyaśva̭rādhasaḥ",
   "veti̱ tvāmṷpa̱seca̭nī̱ vi vo̱ mada̱ ṛjī̭tiragna̱ āhṷti̱rviva̭kṣase"
  ],

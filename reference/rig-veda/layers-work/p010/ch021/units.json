  "lines_deva": [
   "त्वे ध॒र्माण॑ आसते जु॒हूभि॑: सिञ्च॒तीरि॑व",
   "कृ॒ष्णा रू॒पाण्यर्जु॑ना॒ वि वो॒ मदे॒ विश्वा॒ अधि॒ श्रियो॑ धिषे॒ विव॑क्षसे"
  ],
  "lines_iast": [
   "tve dha̱rmāṇa̭ āsate ju̱hūbhi̭: siñca̱tīri̭va",
   "kṛ̱ṣṇā rū̱pāṇyarjṷnā̱ vi vo̱ made̱ viśvā̱ adhi̱ śriyo̭ dhiṣe̱ viva̭kṣase"
  ],

   "010.021.1b"
  ],
  "lines_deva": [
   "आग्निं न स्ववृ॑क्तिभि॒र्होता॑रं त्वा वृणीमहे",
   "य॒ज्ञाय॑ स्ती॒र्णब॑र्हिषे॒ वि वो॒ मदे॑ शी॒रं पा॑व॒कशो॑चिषं॒ विव॑क्षसे"
  ],
  "lines_iast": [
   "āgniṃ na svavṛ̭ktibhi̱rhotā̭raṃ tvā vṛṇīmahe",
   "ya̱jñāya̭ stī̱rṇaba̭rhiṣe̱ vi vo̱ madḙ śī̱raṃ pā̭va̱kaśo̭ciṣa̱ṃ viva̭kṣase"
  ],

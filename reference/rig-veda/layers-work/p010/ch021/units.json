   "भुव॑द्दू॒तो वि॒वस्व॑तो॒ वि वो॒ मदे॑ प्रि॒यो य॒मस्य॒ काम्यो॒ विव॑क्षसे"
  ],
  "lines_iast": [
   "a̱gnirjā̱to atha̭rvaṇā vi̱dadviśvā̭ni̱ kāvyā̭",
   "bhuva̭ddū̱to vi̱vasva̭to̱ vi vo̱ madḙ pri̱yo ya̱masya̱ kāmyo̱ viva̭kṣase"
  ],

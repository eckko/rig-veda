   "002.005.8b"
  ],
  "lines_deva": [
   "यथा॑ वि॒द्वाँ अरं॒ कर॒द् विश्वे॑भ्यो यज॒तेभ्य॑:",
   "अ॒यम॑ग्ने॒ त्वे अपि॒ यं य॒ज्ञं च॑कृ॒मा व॒यम्"
  ],
  "lines_iast": [
   "yathā̭ vi̱dvā~ ara̱ṃ kara̱d viśvḙbhyo yaja̱tebhya̭:",
   "a̱yama̭gne̱ tve api̱ yaṃ ya̱jñaṃ ca̭kṛ̱mā va̱yam"
  ],

 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "002.005.4a",
   "002.005.4b"
  ],
  "lines_deva": [
   "सा॒कं हि शुचि॑ना॒ शुचि॑: प्रशा॒स्ता क्रतु॒नाज॑नि",
   "वि॒द्वाँ अ॑स्य व्र॒ता ध्रु॒वा व॒या इ॒वानु॑ रोहते"
  ],
  "lines_iast": [
   "sā̱kaṃ hi śuci̭nā̱ śuci̭: praśā̱stā kratu̱nāja̭ni",
   "vi̱dvā~ a̭sya vra̱tā dhru̱vā va̱yā i̱vānṷ rohate"
  ],
  "book_split": [

 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "002.005.5a",
   "002.005.5b"
  ],
  "lines_deva": [
   "ता अ॑स्य॒ वर्ण॑मा॒युवो॒ नेष्टु॑: सचन्त धे॒नव॑:",
   "कु॒वित् ति॒सृभ्य॒ आ वरं॒ स्वसा॑रो॒ या इ॒दं य॒युः"
  ],
  "lines_iast": [
   "tā a̭sya̱ varṇa̭mā̱yuvo̱ neṣṭṷ: sacanta dhe̱nava̭:",
   "ku̱vit ti̱sṛbhya̱ ā vara̱ṃ svasā̭ro̱ yā i̱daṃ ya̱yuḥ"
  ],
  "book_split": [

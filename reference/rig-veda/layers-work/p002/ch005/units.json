 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.005.2a",
   "002.005.2b"
  ],
  "lines_deva": [
   "आ यस्मि॑न् त्स॒प्त र॒श्मय॑स्त॒ता य॒ज्ञस्य॑ ने॒तरि॑",
   "म॒नु॒ष्वद् दैव्य॑मष्ट॒मं पोता॒ विश्वं॒ तदि॑न्वति"
  ],
  "lines_iast": [
   "ā yasmi̭n tsa̱pta ra̱śmaya̭sta̱tā ya̱jñasya̭ ne̱tari̭",
   "ma̱nu̱ṣvad daivya̭maṣṭa̱maṃ potā̱ viśva̱ṃ tadi̭nvati"
  ],
  "book_split": [

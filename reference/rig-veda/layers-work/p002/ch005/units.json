   "002.005.6b"
  ],
  "lines_deva": [
   "यदी॑ मा॒तुरुप॒ स्वसा॑ घृ॒तं भर॒न्त्यस्थि॑त",
   "तासा॑मध्व॒र्युराग॑तौ॒ यवो॑ वृ॒ष्टीव॑ मोदते"
  ],
  "lines_iast": [
   "yadī̭ mā̱turupa̱ svasā̭ ghṛ̱taṃ bhara̱ntyasthi̭ta",
   "tāsā̭madhva̱ryurāga̭tau̱ yavo̭ vṛ̱ṣṭīva̭ modate"
  ],

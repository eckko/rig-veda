   "002.005.7b"
  ],
  "lines_deva": [
   "स्वः स्वाय॒ धाय॑से कृणु॒तामृ॒त्विगृ॒त्विज॑म्",
   "स्तोमं॑ य॒ज्ञं चादरं॑ व॒नेमा॑ ररि॒मा व॒यम्"
  ],
  "lines_iast": [
   "svaḥ svāya̱ dhāya̭se kṛṇu̱tāmṛ̱tvigṛ̱tvija̭m",
   "stoma̭ṃ ya̱jñaṃ cādara̭ṃ va̱nemā̭ rari̱mā va̱yam"
  ],

 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.005.3a",
   "002.005.3b"
  ],
  "lines_deva": [
   "द॒ध॒न्वे वा॒ यदी॒मनु॒ वोच॒द् ब्रह्मा॑णि॒ वेरु॒ तत्",
   "परि॒ विश्वा॑नि॒ काव्या॑ ने॒मिश्च॒क्रमि॑वाभवत्"
  ],
  "lines_iast": [
   "da̱dha̱nve vā̱ yadī̱manu̱ voca̱d brahmā̭ṇi̱ veru̱ tat",
   "pari̱ viśvā̭ni̱ kāvyā̭ ne̱miśca̱krami̭vābhavat"
  ],
  "book_split": [

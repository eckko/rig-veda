[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "002.005.1a",
   "002.005.1b"
  ],
  "lines_deva": [
   "होता॑जनिष्ट॒ चेत॑नः पि॒ता पि॒तृभ्य॑ ऊ॒तये॑",
   "प्र॒यक्ष॒ञ्जेन्यं॒ वसु॑ श॒केम॑ वा॒जिनो॒ यम॑म्"
  ],
  "lines_iast": [
   "hotā̭janiṣṭa̱ ceta̭naḥ pi̱tā pi̱tṛbhya̭ ū̱tayḙ",
   "pra̱yakṣa̱ñjenya̱ṃ vasṷ śa̱kema̭ vā̱jino̱ yama̭m"
  ],
  "book_split": [

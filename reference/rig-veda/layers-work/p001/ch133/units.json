 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "001.133.5a",
   "001.133.5b"
  ],
  "lines_deva": [
   "पि॒शङ्ग॑भृष्टिमम्भृ॒णं पि॒शाचि॑मिन्द्र॒ सं मृ॑ण",
   "सर्वं॒ रक्षो॒ नि ब॑र्हय"
  ],
  "lines_iast": [
   "pi̱śaṅga̭bhṛṣṭimambhṛ̱ṇaṃ pi̱śāci̭mindra̱ saṃ mṛ̭ṇa",
   "sarva̱ṃ rakṣo̱ ni ba̭rhaya"
  ],

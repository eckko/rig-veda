 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.133.3a",
   "001.133.3b"
  ],
  "lines_deva": [
   "अवा॑सां मघवञ्जहि॒ शर्धो॑ यातु॒मती॑नाम्",
   "वै॒ल॒स्था॒न॒के अ॑र्म॒के म॒हावै॑लस्थे अर्म॒के"
  ],
  "lines_iast": [
   "avā̭sāṃ maghavañjahi̱ śardho̭ yātu̱matī̭nām",
   "vai̱la̱sthā̱na̱ke a̭rma̱ke ma̱hāvai̭lasthe arma̱ke"
  ],

 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.133.2a",
   "001.133.2b"
  ],
  "lines_deva": [
   "अ॒भि॒व्लग्या॑ चिदद्रिवः शी॒र्षा या॑तु॒मती॑नाम्",
   "छि॒न्धि व॑टू॒रिणा॑ प॒दा म॒हाव॑टूरिणा प॒दा"
  ],
  "lines_iast": [
   "a̱bhi̱vlagyā̭ cidadrivaḥ śī̱rṣā yā̭tu̱matī̭nām",
   "chi̱ndhi va̭ṭū̱riṇā̭ pa̱dā ma̱hāva̭ṭūriṇā pa̱dā"
  ],
  "book_split": [

[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.133.1a",
   "001.133.1b"
  ],
  "lines_deva": [
   "उ॒भे पु॑नामि॒ रोद॑सी ऋ॒तेन॒ द्रुहो॑ दहामि॒ सं म॒हीर॑नि॒न्द्राः",
   "अ॒भि॒व्लग्य॒ यत्र॑ ह॒ता अ॒मित्रा॑ वैलस्था॒नं परि॑ तृ॒ह्ला अशे॑रन्"
  ],
  "lines_iast": [
   "u̱bhe pṷnāmi̱ roda̭sī ṛ̱tena̱ druho̭ dahāmi̱ saṃ ma̱hīra̭ni̱ndrāḥ",
   "a̱bhi̱vlagya̱ yatra̭ ha̱tā a̱mitrā̭ vailasthā̱naṃ pari̭ tṛ̱hlā aśḙran"
  ],
  "book_split": [

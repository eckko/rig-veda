  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.133.4a",
   "001.133.4b"
  ],
  "lines_deva": [
   "यासां॑ ति॒स्रः प॑ञ्चा॒शतो॑ ऽभिव्ल॒ङ्गैर॒पाव॑पः",
   "तत् सु ते॑ मनायति त॒कत् सु ते॑ मनायति"
  ],
  "lines_iast": [
   "yāsā̭ṃ ti̱sraḥ pa̭ñcā̱śato̭ 'bhivla̱ṅgaira̱pāva̭paḥ",
   "tat su tḙ manāyati ta̱kat su tḙ manāyati"
  ],

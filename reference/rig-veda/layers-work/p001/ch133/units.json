 {
  "n": "7",
  "type": "verse",
  "line_ids": [
   "001.133.7a",
   "001.133.7b",
   "001.133.7c"
  ],
  "lines_deva": [
   "व॒नोति॒ हि सु॒न्वन् क्षयं॒ परी॑णसः सुन्वा॒नो हि ष्मा॒ यज॒त्यव॒ द्विषो॑ दे॒वाना॒मव॒ द्विष॑:",
   "सु॒न्वा॒न इत् सि॑षासति स॒हस्रा॑ वा॒ज्यवृ॑तः",
   "सु॒न्वा॒नायेन्द्रो॑ ददात्या॒भुवं॑ र॒यिं द॑दात्या॒भुव॑म्"
  ],
  "lines_iast": [
   "va̱noti̱ hi su̱nvan kṣaya̱ṃ parī̭ṇasaḥ sunvā̱no hi ṣmā̱ yaja̱tyava̱ dviṣo̭ de̱vānā̱mava̱ dviṣa̭:",
   "su̱nvā̱na it si̭ṣāsati sa̱hasrā̭ vā̱jyavṛ̭taḥ",
   "su̱nvā̱nāyendro̭ dadātyā̱bhuva̭ṃ ra̱yiṃ da̭dātyā̱bhuva̭m"
  ],

  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.011.2a",
   "001.011.2b"
  ],
  "lines_deva": [
   "स॒ख्ये त॑ इन्द्र वा॒जिनो॒ मा भे॑म शवसस्पते",
   "त्वाम॒भि प्र णो॑नुमो॒ जेता॑र॒मप॑रा जितम्"
  ],
  "lines_iast": [
   "sa̱khye ta̭ indra vā̱jino̱ mā bhḙma śavasaspate",
   "tvāma̱bhi pra ṇo̭numo̱ jetā̭ra̱mapa̭rā jitam"
  ],
  "book_split": [

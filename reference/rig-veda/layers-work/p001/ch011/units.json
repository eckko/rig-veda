 {
  "n": "7",
  "type": "verse",
  "line_ids": [
   "001.011.7a",
   "001.011.7b"
  ],
  "lines_deva": [
   "मा॒याभि॑रिन्द्र मा॒यिनं॒ त्वं शुष्ण॒मवा॑तिरः",
   "वि॒दुष्टे॒ तस्य॒ मेधि॑रा॒स् तेषां॒ श्रवां॒स्युत्ति॑र"
  ],
  "lines_iast": [
   "mā̱yābhi̭rindra mā̱yina̱ṃ tvaṃ śuṣṇa̱mavā̭tiraḥ",
   "vi̱duṣṭe̱ tasya̱ medhi̭rā̱s teṣā̱ṃ śravā̱ṃsyutti̭ra"
  ],

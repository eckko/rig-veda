  "lines_deva": [
   "इन्द्र॒मीशा॑न॒मोज॑सा॒भि स्तोमा॑ अनूषत",
   "स॒हस्रं॒ यस्य॑ रा॒तय॑ उ॒त वा॒ सन्ति॒ भूय॑सीः"
  ],
  "lines_iast": [
   "indra̱mīśā̭na̱moja̭sā̱bhi stomā̭ anūṣata",
   "sa̱hasra̱ṃ yasya̭ rā̱taya̭ u̱ta vā̱ santi̱ bhūya̭sīḥ"
  ],

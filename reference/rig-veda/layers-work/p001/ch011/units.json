 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "001.011.6a",
   "001.011.6b"
  ],
  "lines_deva": [
   "तवा॒हं शू॑र रा॒तिभि॒: प्रत्या॑यं॒ सिन्धु॑मा॒वद॑न्",
   "उपा॑तिष्ठन्त गिर्वणो वि॒दुष्टे॒ तस्य॑ का॒रव॑:"
  ],
  "lines_iast": [
   "tavā̱haṃ śṷ̄ra rā̱tibhi̱: pratyā̭ya̱ṃ sindhṷmā̱vada̭n",
   "upā̭tiṣṭhanta girvaṇo vi̱duṣṭe̱ tasya̭ kā̱rava̭:"
  ],

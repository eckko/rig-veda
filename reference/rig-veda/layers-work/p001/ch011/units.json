 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "001.011.5a",
   "001.011.5b"
  ],
  "lines_deva": [
   "त्वं व॒लस्य॒ गोम॒तो ऽपा॑वरद्रिवो॒ बिल॑म्",
   "त्वां दे॒वा अबि॑भ्युषस् तु॒ज्यमा॑नास आविषुः"
  ],
  "lines_iast": [
   "tvaṃ va̱lasya̱ goma̱to 'pā̭varadrivo̱ bila̭m",
   "tvāṃ de̱vā abi̭bhyuṣas tu̱jyamā̭nāsa āviṣuḥ"
  ],

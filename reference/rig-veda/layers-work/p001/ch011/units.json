[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.011.1a",
   "001.011.1b"
  ],
  "lines_deva": [
   "इन्द्रं॒ विश्वा॑ अवीवृधन्त् समु॒द्रव्य॑चसं॒ गिर॑:",
   "र॒थीत॑मं र॒थीनां॒ वाजा॑नां॒ सत्प॑तिं॒ पति॑म्"
  ],
  "lines_iast": [
   "indra̱ṃ viśvā̭ avīvṛdhant samu̱dravya̭casa̱ṃ gira̭:",
   "ra̱thīta̭maṃ ra̱thīnā̱ṃ vājā̭nā̱ṃ satpa̭ti̱ṃ pati̭m"
  ],
  "book_split": [

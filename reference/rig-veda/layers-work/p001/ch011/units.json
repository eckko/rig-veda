 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.011.3a",
   "001.011.3b"
  ],
  "lines_deva": [
   "पू॒र्वीरिन्द्र॑स्य रा॒तयो॒ न वि द॑स्यन्त्यू॒तय॑:",
   "यदी॒ वाज॑स्य॒ गोम॑तः स्तो॒तृभ्यो॒ मंह॑ते म॒घम्"
  ],
  "lines_iast": [
   "pū̱rvīrindra̭sya rā̱tayo̱ na vi da̭syantyū̱taya̭:",
   "yadī̱ vāja̭sya̱ goma̭taḥ sto̱tṛbhyo̱ maṃha̭te ma̱gham"
  ],
  "book_split": [

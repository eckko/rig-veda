 },
 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.011.4a",
   "001.011.4b"
  ],
  "lines_deva": [
   "पु॒रां भि॒न्दुर्युवा॑ क॒विरमि॑तौजा अजायत",
   "इन्द्रो॒ विश्व॑स्य॒ कर्म॑णो ध॒र्ता व॒ज्री पु॑रुष्टु॒तः"
  ],
  "lines_iast": [
   "pu̱rāṃ bhi̱nduryuvā̭ ka̱virami̭taujā ajāyata",
   "indro̱ viśva̭sya̱ karma̭ṇo dha̱rtā va̱jrī pṷruṣṭu̱taḥ"
  ],
  "book_split": [

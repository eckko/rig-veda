 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.149.4a",
   "001.149.4b"
  ],
  "lines_deva": [
   "अ॒भि द्वि॒जन्मा॒ त्री रो॑च॒नानि॒ विश्वा॒ रजां॑सि शुशुचा॒नो अ॑स्थात्",
   "होता॒ यजि॑ष्ठो अ॒पां स॒धस्थ॑श"
  ],
  "lines_iast": [
   "a̱bhi dvi̱janmā̱ trī ro̭ca̱nāni̱ viśvā̱ rajā̭ṃsi śuśucā̱no a̭sthāt",
   "hotā̱ yaji̭ṣṭho a̱pāṃ sa̱dhastha̭śa"
  ],

 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "001.149.5a",
   "001.149.5b"
  ],
  "lines_deva": [
   "अ॒यं स होता॒ यो द्वि॒जन्मा॒ विश्वा॑ द॒धे वार्या॑णि श्रव॒स्या",
   "मर्तो॒ यो अ॑स्मै सु॒तुको॑ द॒दाश॑"
  ],
  "lines_iast": [
   "a̱yaṃ sa hotā̱ yo dvi̱janmā̱ viśvā̭ da̱dhe vāryā̭ṇi śrava̱syā",
   "marto̱ yo a̭smai su̱tuko̭ da̱dāśa̭"
  ],

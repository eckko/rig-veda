 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.149.3a",
   "001.149.3b"
  ],
  "lines_deva": [
   "आ यः पुरं॒ नार्मि॑णी॒मदी॑दे॒दत्य॑: क॒विर्न॑भ॒न्यो॒ ३ नार्वा॑",
   "सूरो॒ न रु॑रु॒क्वाञ्छ॒तात्मा॑"
  ],
  "lines_iast": [
   "ā yaḥ pura̱ṃ nārmi̭ṇī̱madī̭de̱datya̭: ka̱virna̭bha̱nyo̱ 3 nārvā̭",
   "sūro̱ na rṷru̱kvāñcha̱tātmā̭"
  ],

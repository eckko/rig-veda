[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.149.1a",
   "001.149.1b"
  ],
  "lines_deva": [
   "म॒हः स रा॒य एष॑ते॒ पति॒र्दन्नि॒न इ॒नस्य॒ वसु॑नः प॒द आ",
   "उप॒ ध्रज॑न्त॒मद्र॑यो वि॒धन्नित्"
  ],
  "lines_iast": [
   "ma̱haḥ sa rā̱ya eṣa̭te̱ pati̱rdanni̱na i̱nasya̱ vasṷnaḥ pa̱da ā",
   "upa̱ dhraja̭nta̱madra̭yo vi̱dhannit"
  ],
  "book_split": [

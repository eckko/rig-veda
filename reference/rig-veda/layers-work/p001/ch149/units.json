  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.149.2a",
   "001.149.2b"
  ],
  "lines_deva": [
   "स यो वृषा॑ न॒रां न रोद॑स्यो॒: श्रवो॑भि॒रस्ति॑ जी॒वपी॑तसर्गः",
   "प्र यः स॑स्रा॒णः शि॑श्री॒त योनौ॑"
  ],
  "lines_iast": [
   "sa yo vṛṣā̭ na̱rāṃ na roda̭syo̱: śravo̭bhi̱rasti̭ jī̱vapī̭tasargaḥ",
   "pra yaḥ sa̭srā̱ṇaḥ śi̭śrī̱ta yonaṷ"
  ],
  "book_split": [

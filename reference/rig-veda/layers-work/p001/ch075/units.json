   "001.075.4b"
  ],
  "lines_deva": [
   "त्वं जा॒मिर्जना॑ना॒मग्ने॑ मि॒त्रो अ॑सि प्रि॒यः",
   "सखा॒ सखि॑भ्य॒ ईड्य॑:"
  ],
  "lines_iast": [
   "tvaṃ jā̱mirjanā̭nā̱magnḙ mi̱tro a̭si pri̱yaḥ",
   "sakhā̱ sakhi̭bhya̱ īḍya̭:"
  ],

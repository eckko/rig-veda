   "001.075.3b"
  ],
  "lines_deva": [
   "कस्ते॑ जा॒मिर्जना॑ना॒मग्ने॒ को दा॒श्व॑ध्वरः",
   "को ह॒ कस्मि॑न्नसि श्रि॒तः"
  ],
  "lines_iast": [
   "kastḙ jā̱mirjanā̭nā̱magne̱ ko dā̱śva̭dhvaraḥ",
   "ko ha̱ kasmi̭nnasi śri̱taḥ"
  ],

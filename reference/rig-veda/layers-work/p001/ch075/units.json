   "001.075.2b"
  ],
  "lines_deva": [
   "अथा॑ ते अङ्गिरस्त॒माग्ने॑ वेधस्तम प्रि॒यम्",
   "वो॒चेम॒ ब्रह्म॑ सान॒सि"
  ],
  "lines_iast": [
   "athā̭ te aṅgirasta̱māgnḙ vedhastama pri̱yam",
   "vo̱cema̱ brahma̭ sāna̱si"
  ],

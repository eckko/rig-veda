  "lines_deva": [
   "जु॒षस्व॑ स॒प्रथ॑स्तमं॒ वचो॑ दे॒वप्स॑रस्तमम्",
   "ह॒व्या जुह्वा॑न आ॒सनि॑"
  ],
  "lines_iast": [
   "ju̱ṣasva̭ sa̱pratha̭stama̱ṃ vaco̭ de̱vapsa̭rastamam",
   "ha̱vyā juhvā̭na ā̱sani̭"
  ],

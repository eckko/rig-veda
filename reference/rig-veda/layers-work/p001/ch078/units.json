  "lines_deva": [
   "अ॒भि त्वा॒ गोत॑मा गि॒रा जात॑वेदो॒ विच॑र्षणे",
   "द्यु॒म्नैर॒भि प्र णो॑नुमः"
  ],
  "lines_iast": [
   "a̱bhi tvā̱ gota̭mā gi̱rā jāta̭vedo̱ vica̭rṣaṇe",
   "dyu̱mnaira̱bhi pra ṇo̭numaḥ"
  ],

 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "001.176.5a",
   "001.176.5b"
  ],
  "lines_deva": [
   "आवो॒ यस्य॑ द्वि॒बर्ह॑सो॒ऽर्केषु॑ सानु॒षगस॑त्",
   "आ॒जाविन्द्र॑स्येन्दो॒ प्रावो॒ वाजे॑षु वा॒जिन॑म्"
  ],
  "lines_iast": [
   "āvo̱ yasya̭ dvi̱barha̭so̱'rkeṣṷ sānu̱ṣagasa̭t",
   "ā̱jāvindra̭syendo̱ prāvo̱ vājḙṣu vā̱jina̭m"
  ],

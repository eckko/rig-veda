 },
 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.176.4a",
   "001.176.4b"
  ],
  "lines_deva": [
   "असु॑न्वन्तं समं जहि दू॒णाशं॒ यो न ते॒ मय॑:",
   "अ॒स्मभ्य॑मस्य॒ वेद॑नं द॒द्धि सू॒रिश्चि॑दोहते"
  ],
  "lines_iast": [
   "asṷnvantaṃ samaṃ jahi dū̱ṇāśa̱ṃ yo na te̱ maya̭:",
   "a̱smabhya̭masya̱ veda̭naṃ da̱ddhi sū̱riści̭dohate"
  ],

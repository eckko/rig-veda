 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "001.176.6a",
   "001.176.6b"
  ],
  "lines_deva": [
   "यथा॒ पूर्वे॑भ्यो जरि॒तृभ्य॑ इन्द्र॒ मय॑ इ॒वापो॒ न तृष्य॑ते ब॒भूथ॑",
   "तामनु॑ त्वा नि॒विदं॑ जोहवीमि वि॒द्यामे॒षं वृ॒जनं॑ जी॒रदा॑नुम्"
  ],
  "lines_iast": [
   "yathā̱ pūrvḙbhyo jari̱tṛbhya̭ indra̱ maya̭ i̱vāpo̱ na tṛṣya̭te ba̱bhūtha̭",
   "tāmanṷ tvā ni̱vida̭ṃ johavīmi vi̱dyāme̱ṣaṃ vṛ̱jana̭ṃ jī̱radā̭num"
  ],

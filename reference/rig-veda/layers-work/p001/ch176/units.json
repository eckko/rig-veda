[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.176.1a",
   "001.176.1b"
  ],
  "lines_deva": [
   "मत्सि॑ नो॒ वस्य॑ इष्टय॒ इन्द्र॑मिन्दो॒ वृषा वि॑श",
   "ऋ॒घा॒यमा॑ण इन्वसि॒ शत्रु॒मन्ति॒ न वि॑न्दसि"
  ],
  "lines_iast": [
   "matsi̭ no̱ vasya̭ iṣṭaya̱ indra̭mindo̱ vṛṣā vi̭śa",
   "ṛ̱ghā̱yamā̭ṇa invasi̱ śatru̱manti̱ na vi̭ndasi"
  ],
  "book_split": [
   "",
   ""
  ],

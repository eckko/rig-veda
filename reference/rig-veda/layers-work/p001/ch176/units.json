 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.176.3a",
   "001.176.3b"
  ],
  "lines_deva": [
   "यस्य॒ विश्वा॑नि॒ हस्त॑यो॒: पञ्च॑ क्षिती॒नां वसु॑",
   "स्पा॒शय॑स्व॒ यो अ॑स्म॒ध्रुग्दि॒व्येवा॒शनि॑र्जहि"
  ],
  "lines_iast": [
   "yasya̱ viśvā̭ni̱ hasta̭yo̱: pañca̭ kṣitī̱nāṃ vasṷ",
   "spā̱śaya̭sva̱ yo a̭sma̱dhrugdi̱vyevā̱śani̭rjahi"
  ],
  "book_split": [

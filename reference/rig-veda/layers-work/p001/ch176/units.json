   " ।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.176.2a",
   "001.176.2b"
  ],
  "lines_deva": [
   "तस्मि॒न्ना वे॑शया॒ गिरो॒ य एक॑श्चर्षणी॒नाम्",
   "अनु॑ स्व॒धा यमु॒प्यते॒ यवं॒ न चर्कृ॑ष॒द् वृषा॑"
  ],
  "lines_iast": [
   "tasmi̱nnā vḙśayā̱ giro̱ ya eka̭ścarṣaṇī̱nām",
   "anṷ sva̱dhā yamu̱pyate̱ yava̱ṃ na carkṛ̭ṣa̱d vṛṣā̭"
  ],
  "book_split": [
   "",

   "001.049.1a",
   "001.049.1b"
  ],
  "lines_deva": [
   "उषो॑ भ॒द्रेभि॒रा ग॑हि दि॒वश्चि॑द् रोच॒नादधि॑",
   "वह॑न्त्वरु॒णप्स॑व॒ उप॑ त्वा सो॒मिनो॑ गृ॒हम्"
  ],
  "lines_iast": [
   "uṣo̭ bha̱drebhi̱rā ga̭hi di̱vaści̭d roca̱nādadhi̭",
   "vaha̭ntvaru̱ṇapsa̭va̱ upa̭ tvā so̱mino̭ gṛ̱ham"
  ],

   "001.049.4a",
   "001.049.4b"
  ],
  "lines_deva": [
   "व्यु॒च्छन्ती॒ हि र॒श्मिभि॒र्विश्व॑मा॒भासि॑ रोच॒नम्",
   "तां त्वामु॑षर्वसू॒यवो॑ गी॒र्भिः कण्वा॑ अहूषत"
  ],
  "lines_iast": [
   "vyu̱cchantī̱ hi ra̱śmibhi̱rviśva̭mā̱bhāsi̭ roca̱nam",
   "tāṃ tvāmṷṣarvasū̱yavo̭ gī̱rbhiḥ kaṇvā̭ ahūṣata"
  ],

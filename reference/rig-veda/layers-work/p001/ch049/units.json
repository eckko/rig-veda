 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.049.2a",
   "001.049.2b"
  ],
  "lines_deva": [
   "सु॒पेश॑सं सु॒खं रथं॒ यम॒ध्यस्था॑ उष॒स्त्वम्",
   "तेना॑ सु॒श्रव॑सं॒ जनं॒ प्रावा॒द्य दु॑हितर्दिवः"
  ],
  "lines_iast": [
   "su̱peśa̭saṃ su̱khaṃ ratha̱ṃ yama̱dhyasthā̭ uṣa̱stvam",
   "tenā̭ su̱śrava̭sa̱ṃ jana̱ṃ prāvā̱dya dṷhitardivaḥ"
  ],

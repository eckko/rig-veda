   "001.049.3b"
  ],
  "lines_deva": [
   "वय॑श्चित् ते पत॒त्रिणो॑ द्वि॒पच्चतु॑ष्पदर्जुनि",
   "उष॒: प्रार॑न्नृ॒तूँरनु॑ दि॒वो अन्ते॑भ्य॒स्परि॑"
  ],
  "lines_iast": [
   "vaya̭ścit te pata̱triṇo̭ dvi̱paccatṷṣpadarjuni",
   "uṣa̱: prāra̭nnṛ̱tū~ranṷ di̱vo antḙbhya̱spari̭"
  ],

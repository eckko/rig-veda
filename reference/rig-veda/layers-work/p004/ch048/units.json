   "004.048.1b"
  ],
  "lines_deva": [
   "वि॒हि होत्रा॒ अवी॑ता॒ विपो॒ न रायो॑ अ॒र्यः",
   "वाय॒वा च॒न्द्रेण॒ रथे॑न या॒हि सु॒तस्य॑ पी॒तये॑"
  ],
  "lines_iast": [
   "vi̱hi hotrā̱ avī̭tā̱ vipo̱ na rāyo̭ a̱ryaḥ",
   "vāya̱vā ca̱ndreṇa̱ rathḙna yā̱hi su̱tasya̭ pī̱tayḙ"
  ],

  "lines_deva": [
   "वह॑न्तु त्वा मनो॒युजो॑ यु॒क्तासो॑ नव॒तिर्नव॑",
   "वाय॒वा च॒न्द्रेण॒ रथे॑न या॒हि सु॒तस्य॑ पी॒तये॑"
  ],
  "lines_iast": [
   "vaha̭ntu tvā mano̱yujo̭ yu̱ktāso̭ nava̱tirnava̭",
   "vāya̱vā ca̱ndreṇa̱ rathḙna yā̱hi su̱tasya̭ pī̱tayḙ"
  ],

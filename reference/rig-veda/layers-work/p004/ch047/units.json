   "004.047.3a",
   "004.047.3b"
  ],
  "lines_deva": [
   "वाय॒विन्द्र॑श्च शु॒ष्मिणा॑ स॒रथं॑ शवसस्पती",
   "नि॒युत्व॑न्ता न ऊ॒तय॒ आ या॑तं॒ सोम॑पीतये"
  ],
  "lines_iast": [
   "vāya̱vindra̭śca śu̱ṣmiṇā̭ sa̱ratha̭ṃ śavasaspatī",
   "ni̱yutva̭ntā na ū̱taya̱ ā yā̭ta̱ṃ soma̭pītaye"
  ],

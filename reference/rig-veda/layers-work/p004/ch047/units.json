   "004.047.2a",
   "004.047.2b"
  ],
  "lines_deva": [
   "इन्द्र॑श्च वायवेषां॒ सोमा॑नां पी॒तिम॑र्हथः",
   "यु॒वां हि यन्तीन्द॑वो नि॒म्नमापो॒ न स॒ध्र्य॑क्"
  ],
  "lines_iast": [
   "indra̭śca vāyaveṣā̱ṃ somā̭nāṃ pī̱tima̭rhathaḥ",
   "yu̱vāṃ hi yantīnda̭vo ni̱mnamāpo̱ na sa̱dhrya̭k"
  ],

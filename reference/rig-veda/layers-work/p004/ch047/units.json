   "004.047.1a",
   "004.047.1b"
  ],
  "lines_deva": [
   "वायो॑ शु॒क्रो अ॑यामि ते॒ मध्वो॒ अग्रं॒ दिवि॑ष्टिषु",
   "आ या॑हि॒ सोम॑पीतये स्पा॒र्हो दे॑व नि॒युत्व॑ता"
  ],
  "lines_iast": [
   "vāyo̭ śu̱kro a̭yāmi te̱ madhvo̱ agra̱ṃ divi̭ṣṭiṣu",
   "ā yā̭hi̱ soma̭pītaye spā̱rho dḙva ni̱yutva̭tā"
  ],

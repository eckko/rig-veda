   "004.047.4a",
   "004.047.4b"
  ],
  "lines_deva": [
   "या वां॒ सन्ति॑ पुरु॒स्पृहो॑ नि॒युतो॑ दा॒शुषे॑ नरा",
   "अ॒स्मे ता य॑ज्ञवाह॒सेन्द्र॑वायू॒ नि य॑च्छतम्"
  ],
  "lines_iast": [
   "yā vā̱ṃ santi̭ puru̱spṛho̭ ni̱yuto̭ dā̱śuṣḙ narā",
   "a̱sme tā ya̭jñavāha̱sendra̭vāyū̱ ni ya̭cchatam"
  ],

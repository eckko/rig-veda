 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.009.3a",
   "005.009.3b"
  ],
  "lines_deva": [
   "उ॒त स्म॒ यं शिशुं॑ यथा॒ नवं॒ जनि॑ष्टा॒रणी॑",
   "ध॒र्तारं॒ मानु॑षीणां वि॒शाम॒ग्निं स्व॑ध्व॒रम्"
  ],
  "lines_iast": [
   "u̱ta sma̱ yaṃ śiśṷṃ yathā̱ nava̱ṃ jani̭ṣṭā̱raṇī̭",
   "dha̱rtāra̱ṃ mānṷṣīṇāṃ vi̱śāma̱gniṃ sva̭dhva̱ram"
  ],
  "book_split": [

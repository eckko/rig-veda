   "005.009.2a",
   "005.009.2b"
  ],
  "lines_deva": [
   "अ॒ग्निर्होता॒ दास्व॑त॒: क्षय॑स्य वृ॒क्तब॑र्हिषः",
   "सं य॒ज्ञास॒श्चर॑न्ति॒ यं सं वाजा॑सः श्रव॒स्यव॑:"
  ],
  "lines_iast": [
   "a̱gnirhotā̱ dāsva̭ta̱: kṣaya̭sya vṛ̱ktaba̭rhiṣaḥ",
   "saṃ ya̱jñāsa̱ścara̭nti̱ yaṃ saṃ vājā̭saḥ śrava̱syava̭:"
  ],

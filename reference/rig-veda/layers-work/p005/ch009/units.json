   "005.009.6b"
  ],
  "lines_deva": [
   "तवा॒हम॑ग्न ऊ॒तिभि॑र्मि॒त्रस्य॑ च॒ प्रश॑स्तिभिः",
   "द्वे॒षो॒युतो॒ न दु॑रि॒ता तु॒र्याम॒ मर्त्या॑नाम्"
  ],
  "lines_iast": [
   "tavā̱hama̭gna ū̱tibhi̭rmi̱trasya̭ ca̱ praśa̭stibhiḥ",
   "dve̱ṣo̱yuto̱ na dṷri̱tā tu̱ryāma̱ martyā̭nām"
  ],

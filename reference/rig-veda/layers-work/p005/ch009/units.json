   "005.009.4a",
   "005.009.4b"
  ],
  "lines_deva": [
   "उ॒त स्म॑ दुर्गृभीयसे पु॒त्रो न ह्वा॒र्याणा॑म्",
   "पु॒रू यो दग्धासि॒ वना ऽग्ने॑ प॒शुर्न यव॑से"
  ],
  "lines_iast": [
   "u̱ta sma̭ durgṛbhīyase pu̱tro na hvā̱ryāṇā̭m",
   "pu̱rū yo dagdhāsi̱ vanā 'gnḙ pa̱śurna yava̭se"
  ],

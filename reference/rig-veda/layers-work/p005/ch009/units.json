   "005.009.5b"
  ],
  "lines_deva": [
   "अध॑ स्म॒ यस्या॒र्चय॑: स॒म्यक् संयन्ति॑ धू॒मिन॑:",
   "यदी॒मह॑ त्रि॒तो दि॒व्युप॒ ध्माते॑व॒ धम॑ति॒ शिशी॑ते ध्मा॒तरी॑ यथा"
  ],
  "lines_iast": [
   "adha̭ sma̱ yasyā̱rcaya̭: sa̱myak saṃyanti̭ dhū̱mina̭:",
   "yadī̱maha̭ tri̱to di̱vyupa̱ dhmātḙva̱ dhama̭ti̱ śiśī̭te dhmā̱tarī̭ yathā"
  ],

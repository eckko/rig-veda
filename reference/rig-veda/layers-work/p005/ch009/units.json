   "005.009.7a",
   "005.009.7b"
  ],
  "lines_deva": [
   "तं नो॑ अग्ने अ॒भी नरो॑ र॒यिं स॑हस्व॒ आ भ॑र",
   "स क्षे॑पय॒त् स पो॑षय॒द् भुव॒द् वाज॑स्य सा॒तय॑ उ॒तैधि॑ पृ॒त्सु नो॑ वृ॒धे"
  ],
  "lines_iast": [
   "taṃ no̭ agne a̱bhī naro̭ ra̱yiṃ sa̭hasva̱ ā bha̭ra",
   "sa kṣḙpaya̱t sa po̭ṣaya̱d bhuva̱d vāja̭sya sā̱taya̭ u̱taidhi̭ pṛ̱tsu no̭ vṛ̱dhe"
  ],

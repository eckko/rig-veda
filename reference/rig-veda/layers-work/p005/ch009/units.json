   "005.009.1a",
   "005.009.1b"
  ],
  "lines_deva": [
   "त्वाम॑ग्ने ह॒विष्म॑न्तो दे॒वं मर्ता॑स ईळते",
   "मन्ये॑ त्वा जा॒तवे॑दसं॒ स ह॒व्या व॑क्ष्यानु॒षक्"
  ],
  "lines_iast": [
   "tvāma̭gne ha̱viṣma̭nto de̱vaṃ martā̭sa īḻate",
   "manyḙ tvā jā̱tavḙdasa̱ṃ sa ha̱vyā va̭kṣyānu̱ṣak"
  ],

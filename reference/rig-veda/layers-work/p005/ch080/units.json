 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.080.3a",
   "005.080.3b"
  ],
  "lines_deva": [
   "ए॒षा गोभि॑ररु॒णेभि॑र्युजा॒ना ऽस्रे॑धन्ती र॒यिमप्रा॑यु चक्रे",
   "प॒थो रद॑न्ती सुवि॒ताय॑ दे॒वी पु॑रुष्टु॒ता वि॒श्ववा॑रा॒ वि भा॑ति"
  ],
  "lines_iast": [
   "e̱ṣā gobhi̭raru̱ṇebhi̭ryujā̱nā 'srḙdhantī ra̱yimaprā̭yu cakre",
   "pa̱tho rada̭ntī suvi̱tāya̭ de̱vī pṷruṣṭu̱tā vi̱śvavā̭rā̱ vi bhā̭ti"
  ],

 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.080.4a",
   "005.080.4b"
  ],
  "lines_deva": [
   "ए॒षा व्ये॑नी भवति द्वि॒बर्हा॑ आविष्कृण्वा॒ना त॒न्वं॑ पु॒रस्ता॑त्",
   "ऋ॒तस्य॒ पन्था॒मन्वे॑ति सा॒धु प्र॑जान॒तीव॒ न दिशो॑ मिनाति"
  ],
  "lines_iast": [
   "e̱ṣā vyḙnī bhavati dvi̱barhā̭ āviṣkṛṇvā̱nā ta̱nva̭ṃ pu̱rastā̭t",
   "ṛ̱tasya̱ panthā̱manvḙti sā̱dhu pra̭jāna̱tīva̱ na diśo̭ mināti"
  ],

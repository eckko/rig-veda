   "005.080.1a",
   "005.080.1b"
  ],
  "lines_deva": [
   "द्यु॒तद्या॑मानं बृह॒तीमृ॒तेन॑ ऋ॒ताव॑रीमरु॒णप्सुं॑ विभा॒तीम्",
   "दे॒वीमु॒षसं॒ स्व॑रा॒वह॑न्तीं॒ प्रति॒ विप्रा॑सो म॒तिभि॑र्जरन्ते"
  ],
  "lines_iast": [
   "dyu̱tadyā̭mānaṃ bṛha̱tīmṛ̱tena̭ ṛ̱tāva̭rīmaru̱ṇapsṷṃ vibhā̱tīm",
   "de̱vīmu̱ṣasa̱ṃ sva̭rā̱vaha̭ntī̱ṃ prati̱ viprā̭so ma̱tibhi̭rjarante"
  ],

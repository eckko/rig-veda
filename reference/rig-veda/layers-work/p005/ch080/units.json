 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "005.080.5a",
   "005.080.5b"
  ],
  "lines_deva": [
   "ए॒षा शु॒भ्रा न त॒न्वो॑ विदा॒नोर्ध्वेव॑ स्ना॒ती दृ॒शये॑ नो अस्थात्",
   "अप॒ द्वेषो॒ बाध॑माना॒ तमां॑स्यु॒षा दि॒वो दु॑हि॒ता ज्योति॒षागा॑त्"
  ],
  "lines_iast": [
   "e̱ṣā śu̱bhrā na ta̱nvo̭ vidā̱nordhveva̭ snā̱tī dṛ̱śayḙ no asthāt",
   "apa̱ dveṣo̱ bādha̭mānā̱ tamā̭ṃsyu̱ṣā di̱vo dṷhi̱tā jyoti̱ṣāgā̭t"
  ],

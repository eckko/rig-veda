 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "005.080.6a",
   "005.080.6b"
  ],
  "lines_deva": [
   "ए॒षा प्र॑ती॒ची दु॑हि॒ता दि॒वो नॄन् योषे॑व भ॒द्रा नि रि॑णीते॒ अप्स॑:",
   "व्यू॒र्ण्व॒ती दा॒शुषे॒ वार्या॑णि॒ पुन॒र्ज्योति॑र्युव॒तिः पू॒र्वथा॑कः"
  ],
  "lines_iast": [
   "e̱ṣā pra̭tī̱cī dṷhi̱tā di̱vo nṝn yoṣḙva bha̱drā ni ri̭ṇīte̱ apsa̭:",
   "vyū̱rṇva̱tī dā̱śuṣe̱ vāryā̭ṇi̱ puna̱rjyoti̭ryuva̱tiḥ pū̱rvathā̭kaḥ"
  ],

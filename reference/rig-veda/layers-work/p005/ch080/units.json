 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.080.2a",
   "005.080.2b"
  ],
  "lines_deva": [
   "ए॒षा जनं॑ दर्श॒ता बो॒धय॑न्ती सु॒गान् प॒थः कृ॑ण्व॒ती या॒त्यग्रे॑",
   "बृ॒ह॒द्र॒था बृ॑ह॒ती वि॑श्वमि॒न्वोषा ज्योति॑र्यच्छ॒त्यग्रे॒ अह्ना॑म्"
  ],
  "lines_iast": [
   "e̱ṣā jana̭ṃ darśa̱tā bo̱dhaya̭ntī su̱gān pa̱thaḥ kṛ̭ṇva̱tī yā̱tyagrḙ",
   "bṛ̱ha̱dra̱thā bṛ̭ha̱tī vi̭śvami̱nvoṣā jyoti̭ryaccha̱tyagre̱ ahnā̭m"
  ],

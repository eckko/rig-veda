   "005.016.3a",
   "005.016.3b"
  ],
  "lines_deva": [
   "अ॒स्य स्तोमे॑ म॒घोन॑: स॒ख्ये वृ॒द्धशो॑चिषः",
   "विश्वा॒ यस्मि॑न् तुवि॒ष्वणि॒ सम॒र्ये शुष्म॑माद॒धुः"
  ],
  "lines_iast": [
   "a̱sya stomḙ ma̱ghona̭: sa̱khye vṛ̱ddhaśo̭ciṣaḥ",
   "viśvā̱ yasmi̭n tuvi̱ṣvaṇi̱ sama̱rye śuṣma̭māda̱dhuḥ"
  ],

  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.016.2a",
   "005.016.2b"
  ],
  "lines_deva": [
   "स हि द्युभि॒र्जना॑नां॒ होता॒ दक्ष॑स्य बा॒ह्वोः",
   "वि ह॒व्यम॒ग्निरा॑नु॒षग्भगो॒ न वार॑मृण्वति"
  ],
  "lines_iast": [
   "sa hi dyubhi̱rjanā̭nā̱ṃ hotā̱ dakṣa̭sya bā̱hvoḥ",
   "vi ha̱vyama̱gnirā̭nu̱ṣagbhago̱ na vāra̭mṛṇvati"
  ],

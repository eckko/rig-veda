   "005.016.5b"
  ],
  "lines_deva": [
   "नू न॒ एहि॒ वार्य॒मग्ने॑ गृणा॒न आ भ॑र",
   "ये व॒यं ये च॑ सू॒रय॑: स्व॒स्ति धाम॑हे॒ सचो॒तैधि॑ पृ॒त्सु नो॑ वृ॒धे"
  ],
  "lines_iast": [
   "nū na̱ ehi̱ vārya̱magnḙ gṛṇā̱na ā bha̭ra",
   "ye va̱yaṃ ye ca̭ sū̱raya̭: sva̱sti dhāma̭he̱ saco̱taidhi̭ pṛ̱tsu no̭ vṛ̱dhe"
  ],

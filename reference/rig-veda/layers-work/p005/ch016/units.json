   "005.016.4b"
  ],
  "lines_deva": [
   "अधा॒ ह्य॑ग्न एषां सु॒वीर्य॑स्य मं॒हना॑",
   "तमिद् य॒ह्वं न रोद॑सी॒ परि॒ श्रवो॑ बभूवतुः"
  ],
  "lines_iast": [
   "adhā̱ hya̭gna eṣāṃ su̱vīrya̭sya ma̱ṃhanā̭",
   "tamid ya̱hvaṃ na roda̭sī̱ pari̱ śravo̭ babhūvatuḥ"
  ],

   "005.016.1a",
   "005.016.1b"
  ],
  "lines_deva": [
   "बृ॒हद् वयो॒ हि भा॒नवेऽर्चा॑ दे॒वाया॒ग्नये॑",
   "यं मि॒त्रं न प्रश॑स्तिभि॒र्मर्ता॑सो दधि॒रे पु॒रः"
  ],
  "lines_iast": [
   "bṛ̱had vayo̱ hi bhā̱nave'rcā̭ de̱vāyā̱gnayḙ",
   "yaṃ mi̱traṃ na praśa̭stibhi̱rmartā̭so dadhi̱re pu̱raḥ"
  ],

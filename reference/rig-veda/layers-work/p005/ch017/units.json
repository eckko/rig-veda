   "005.017.4b"
  ],
  "lines_deva": [
   "अ॒स्य क्रत्वा॒ विचे॑तसो द॒स्मस्य॒ वसु॒ रथ॒ आ",
   "अधा॒ विश्वा॑सु॒ हव्यो॒ऽग्निर्वि॒क्षु प्र श॑स्यते"
  ],
  "lines_iast": [
   "a̱sya kratvā̱ vicḙtaso da̱smasya̱ vasu̱ ratha̱ ā",
   "adhā̱ viśvā̭su̱ havyo̱'gnirvi̱kṣu pra śa̭syate"
  ],

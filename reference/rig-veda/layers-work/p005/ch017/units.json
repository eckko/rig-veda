  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.017.2a",
   "005.017.2b"
  ],
  "lines_deva": [
   "अस्य॒ हि स्वय॑शस्तर आ॒सा वि॑धर्म॒न् मन्य॑से",
   "तं नाकं॑ चि॒त्रशो॑चिषं म॒न्द्रं प॒रो म॑नी॒षया॑"
  ],
  "lines_iast": [
   "asya̱ hi svaya̭śastara ā̱sā vi̭dharma̱n manya̭se",
   "taṃ nāka̭ṃ ci̱traśo̭ciṣaṃ ma̱ndraṃ pa̱ro ma̭nī̱ṣayā̭"
  ],

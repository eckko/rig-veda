   "005.017.5b"
  ],
  "lines_deva": [
   "नू न॒ इद्धि वार्य॑मा॒सा स॑चन्त सू॒रय॑:",
   "ऊर्जो॑ नपाद॒भिष्ट॑ये पा॒हि श॒ग्धि स्व॒स्तय॑ उ॒तैधि॑ पृ॒त्सु नो॑ वृ॒धे"
  ],
  "lines_iast": [
   "nū na̱ iddhi vārya̭mā̱sā sa̭canta sū̱raya̭:",
   "ūrjo̭ napāda̱bhiṣṭa̭ye pā̱hi śa̱gdhi sva̱staya̭ u̱taidhi̭ pṛ̱tsu no̭ vṛ̱dhe"
  ],

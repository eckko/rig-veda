 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.017.3a",
   "005.017.3b"
  ],
  "lines_deva": [
   "अ॒स्य वासा उ॑ अ॒र्चिषा॒ य आयु॑क्त तु॒जा गि॒रा",
   "दि॒वो न यस्य॒ रेत॑सा बृ॒हच्छोच॑न्त्य॒र्चय॑:"
  ],
  "lines_iast": [
   "a̱sya vāsā ṷ a̱rciṣā̱ ya āyṷkta tu̱jā gi̱rā",
   "di̱vo na yasya̱ reta̭sā bṛ̱hacchoca̭ntya̱rcaya̭:"
  ],

   "005.017.1a",
   "005.017.1b"
  ],
  "lines_deva": [
   "आ य॒ज्ञैर्दे॑व॒ मर्त्य॑ इ॒त्था तव्यां॑समू॒तये॑",
   "अ॒ग्निं कृ॒ते स्व॑ध्व॒रे पू॒रुरी॑ळी॒ताव॑से"
  ],
  "lines_iast": [
   "ā ya̱jñairdḙva̱ martya̭ i̱tthā tavyā̭ṃsamū̱tayḙ",
   "a̱gniṃ kṛ̱te sva̭dhva̱re pū̱rurī̭ḻī̱tāva̭se"
  ],
  "book_split": [

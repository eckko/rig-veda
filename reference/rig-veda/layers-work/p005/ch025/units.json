   ""
  ],
  "book_english": [
   "",
   ""
  ],
  "uncertain": [],
  "trailers": [
   " ।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.025.2a",
   "005.025.2b"
  ],
  "lines_deva": [
   "स हि स॒त्यो यं पूर्वे॑ चिद् दे॒वास॑श्चि॒द् यमी॑धि॒रे",
   "होता॑रं म॒न्द्रजि॑ह्व॒मित् सु॑दी॒तिभि॑र्वि॒भाव॑सुम्"
  ],
  "lines_iast": [
   "sa hi sa̱tyo yaṃ pūrvḙ cid de̱vāsa̭ści̱d yamī̭dhi̱re",
   "hotā̭raṃ ma̱ndraji̭hva̱mit sṷdī̱tibhi̭rvi̱bhāva̭sum"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
   "",
   ""
  ],
  "book_english": [
   "",
   ""

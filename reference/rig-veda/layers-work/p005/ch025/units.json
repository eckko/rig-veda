   " ।",
   " ॥"
  ]
 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.025.3a",
   "005.025.3b"
  ],
  "lines_deva": [
   "स नो॑ धी॒ती वरि॑ष्ठया॒ श्रेष्ठ॑या च सुम॒त्या",
   "अग्ने॑ रा॒यो दि॑दीहि नः सुवृ॒क्तिभि॑र्वरेण्य"
  ],
  "lines_iast": [
   "sa no̭ dhī̱tī vari̭ṣṭhayā̱ śreṣṭha̭yā ca suma̱tyā",
   "agnḙ rā̱yo di̭dīhi naḥ suvṛ̱ktibhi̭rvareṇya"
  ],
  "book_split": [
   "",

 },
 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "005.025.6a",
   "005.025.6b"
  ],
  "lines_deva": [
   "अ॒ग्निर्द॑दाति॒ सत्प॑तिं सा॒साह॒ यो यु॒धा नृभि॑:",
   "अ॒ग्निरत्यं॑ रघु॒ष्यदं॒ जेता॑र॒मप॑राजितम्"
  ],
  "lines_iast": [
   "a̱gnirda̭dāti̱ satpa̭tiṃ sā̱sāha̱ yo yu̱dhā nṛbhi̭:",
   "a̱gniratya̭ṃ raghu̱ṣyada̱ṃ jetā̭ra̱mapa̭rājitam"
  ],

 {
  "n": "8",
  "type": "verse",
  "line_ids": [
   "005.025.8a",
   "005.025.8b"
  ],
  "lines_deva": [
   "तव॑ द्यु॒मन्तो॑ अ॒र्चयो॒ ग्रावे॑वोच्यते बृ॒हत्",
   "उ॒तो ते॑ तन्य॒तुर्य॑था स्वा॒नो अ॑र्त॒ त्मना॑ दि॒वः"
  ],
  "lines_iast": [
   "tava̭ dyu̱manto̭ a̱rcayo̱ grāvḙvocyate bṛ̱hat",
   "u̱to tḙ tanya̱turya̭thā svā̱no a̭rta̱ tmanā̭ di̱vaḥ"
  ],

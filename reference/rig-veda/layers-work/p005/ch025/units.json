[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.025.1a",
   "005.025.1b"
  ],
  "lines_deva": [
   "अच्छा॑ वो अ॒ग्निमव॑से दे॒वं गा॑सि॒ स नो॒ वसु॑:",
   "रास॑त् पु॒त्र ऋ॑षू॒णामृ॒तावा॑ पर्षति द्वि॒षः"
  ],
  "lines_iast": [
   "acchā̭ vo a̱gnimava̭se de̱vaṃ gā̭si̱ sa no̱ vasṷ:",
   "rāsa̭t pu̱tra ṛ̭ṣū̱ṇāmṛ̱tāvā̭ parṣati dvi̱ṣaḥ"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [

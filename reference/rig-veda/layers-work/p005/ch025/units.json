  ]
 },
 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "005.025.5a",
   "005.025.5b"
  ],
  "lines_deva": [
   "अ॒ग्निस्तु॒विश्र॑वस्तमं तु॒विब्र॑ह्माणमुत्त॒मम्",
   "अ॒तूर्तं॑ श्राव॒यत्प॑तिं पु॒त्रं द॑दाति दा॒शुषे॑"
  ],
  "lines_iast": [
   "a̱gnistu̱viśra̭vastamaṃ tu̱vibra̭hmāṇamutta̱mam",
   "a̱tūrta̭ṃ śrāva̱yatpa̭tiṃ pu̱traṃ da̭dāti dā̱śuṣḙ"
  ],
  "book_split": [

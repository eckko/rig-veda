 },
 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.025.4a",
   "005.025.4b"
  ],
  "lines_deva": [
   "अ॒ग्निर्दे॒वेषु॑ राजत्य॒ग्निर्मर्ते॑ष्वावि॒शन्",
   "अ॒ग्निर्नो॑ हव्य॒वाह॑नो॒ऽग्निं धी॒भिः स॑पर्यत"
  ],
  "lines_iast": [
   "a̱gnirde̱veṣṷ rājatya̱gnirmartḙṣvāvi̱śan",
   "a̱gnirno̭ havya̱vāha̭no̱'gniṃ dhī̱bhiḥ sa̭paryata"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [

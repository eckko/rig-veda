 {
  "n": "7",
  "type": "verse",
  "line_ids": [
   "005.025.7a",
   "005.025.7b"
  ],
  "lines_deva": [
   "यद् वाहि॑ष्ठं॒ तद॒ग्नये॑ बृ॒हद॑र्च विभावसो",
   "महि॑षीव॒ त्वद् र॒यिस्त्वद् वाजा॒ उदी॑रते"
  ],
  "lines_iast": [
   "yad vāhi̭ṣṭha̱ṃ tada̱gnayḙ bṛ̱hada̭rca vibhāvaso",
   "mahi̭ṣīva̱ tvad ra̱yistvad vājā̱ udī̭rate"
  ],

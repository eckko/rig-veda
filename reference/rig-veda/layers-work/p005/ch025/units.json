 {
  "n": "9",
  "type": "verse",
  "line_ids": [
   "005.025.9a",
   "005.025.9b"
  ],
  "lines_deva": [
   "ए॒वाँ अ॒ग्निं व॑सू॒यव॑: सहसा॒नं व॑वन्दिम",
   "स नो॒ विश्वा॒ अति॒ द्विष॒: पर्ष॑न्ना॒वेव॑ सु॒क्रतु॑:"
  ],
  "lines_iast": [
   "e̱vā~ a̱gniṃ va̭sū̱yava̭: sahasā̱naṃ va̭vandima",
   "sa no̱ viśvā̱ ati̱ dviṣa̱: parṣa̭nnā̱veva̭ su̱kratṷ:"
  ],

 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.018.4a",
   "005.018.4b"
  ],
  "lines_deva": [
   "चि॒त्रा वा॒ येषु॒ दीधि॑तिरा॒सन्नु॒क्था पान्ति॒ ये",
   "स्ती॒र्णं ब॒र्हिः स्व॑र्णरे॒ श्रवां॑सि दधिरे॒ परि॑"
  ],
  "lines_iast": [
   "ci̱trā vā̱ yeṣu̱ dīdhi̭tirā̱sannu̱kthā pānti̱ ye",
   "stī̱rṇaṃ ba̱rhiḥ sva̭rṇare̱ śravā̭ṃsi dadhire̱ pari̭"
  ],

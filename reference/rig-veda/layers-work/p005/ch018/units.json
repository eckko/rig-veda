  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.018.2a",
   "005.018.2b"
  ],
  "lines_deva": [
   "द्वि॒ताय॑ मृ॒क्तवा॑हसे॒ स्वस्य॒ दक्ष॑स्य मं॒हना॑",
   "इन्दुं॒ स ध॑त्त आनु॒षक् स्तो॒ता चि॑त्ते अमर्त्य"
  ],
  "lines_iast": [
   "dvi̱tāya̭ mṛ̱ktavā̭hase̱ svasya̱ dakṣa̭sya ma̱ṃhanā̭",
   "indu̱ṃ sa dha̭tta ānu̱ṣak sto̱tā ci̭tte amartya"
  ],
  "book_split": [

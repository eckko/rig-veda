 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "005.018.5a",
   "005.018.5b"
  ],
  "lines_deva": [
   "ये मे॑ पञ्चा॒शतं॑ द॒दुरश्वा॑नां स॒धस्तु॑ति",
   "द्यु॒मद॑ग्ने॒ महि॒ श्रवो॑ बृ॒हत् कृ॑धि म॒घोनां॑ नृ॒वद॑मृत नृ॒णाम्"
  ],
  "lines_iast": [
   "ye mḙ pañcā̱śata̭ṃ da̱duraśvā̭nāṃ sa̱dhastṷti",
   "dyu̱mada̭gne̱ mahi̱ śravo̭ bṛ̱hat kṛ̭dhi ma̱ghonā̭ṃ nṛ̱vada̭mṛta nṛ̱ṇām"
  ],

 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.018.3a",
   "005.018.3b"
  ],
  "lines_deva": [
   "तं वो॑ दी॒र्घायु॑शोचिषं गि॒रा हु॑वे म॒घोना॑म्",
   "अरि॑ष्टो॒ येषां॒ रथो॒ व्य॑श्वदाव॒न्नीय॑ते"
  ],
  "lines_iast": [
   "taṃ vo̭ dī̱rghāyṷśociṣaṃ gi̱rā hṷve ma̱ghonā̭m",
   "ari̭ṣṭo̱ yeṣā̱ṃ ratho̱ vya̭śvadāva̱nnīya̭te"
  ],
  "book_split": [

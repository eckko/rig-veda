[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.018.1a",
   "005.018.1b"
  ],
  "lines_deva": [
   "प्रा॒तर॒ग्निः पु॑रुप्रि॒यो वि॒शः स्त॑वे॒ताति॑थिः",
   "विश्वा॑नि॒ यो अम॑र्त्यो ह॒व्या मर्ते॑षु॒ रण्य॑ति"
  ],
  "lines_iast": [
   "prā̱tara̱gniḥ pṷrupri̱yo vi̱śaḥ sta̭ve̱tāti̭thiḥ",
   "viśvā̭ni̱ yo ama̭rtyo ha̱vyā martḙṣu̱ raṇya̭ti"
  ],
  "book_split": [

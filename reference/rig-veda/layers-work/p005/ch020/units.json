 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.020.2a",
   "005.020.2b"
  ],
  "lines_deva": [
   "ये अ॑ग्ने॒ नेरय॑न्ति ते वृ॒द्धा उ॒ग्रस्य॒ शव॑सः",
   "अप॒ द्वेषो॒ अप॒ ह्वरो॒ऽन्यव्र॑तस्य सश्चिरे"
  ],
  "lines_iast": [
   "ye a̭gne̱ neraya̭nti te vṛ̱ddhā u̱grasya̱ śava̭saḥ",
   "apa̱ dveṣo̱ apa̱ hvaro̱'nyavra̭tasya saścire"
  ],

   "005.020.4a",
   "005.020.4b"
  ],
  "lines_deva": [
   "इ॒त्था यथा॑ त ऊ॒तये॒ सह॑सावन्दि॒वेदि॑वे",
   "रा॒य ऋ॒ताय॑ सुक्रतो॒ गोभि॑: ष्याम सध॒मादो॑ वी॒रैः स्या॑म सध॒माद॑:"
  ],
  "lines_iast": [
   "i̱tthā yathā̭ ta ū̱taye̱ saha̭sāvandi̱vedi̭ve",
   "rā̱ya ṛ̱tāya̭ sukrato̱ gobhi̭: ṣyāma sadha̱mādo̭ vī̱raiḥ syā̭ma sadha̱māda̭:"
  ],

 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.020.3a",
   "005.020.3b"
  ],
  "lines_deva": [
   "होता॑रं त्वा वृणीम॒हेऽग्ने॒ दक्ष॑स्य॒ साध॑नम्",
   "य॒ज्ञेषु॑ पू॒र्व्यं गि॒रा प्रय॑स्वन्तो हवामहे"
  ],
  "lines_iast": [
   "hotā̭raṃ tvā vṛṇīma̱he'gne̱ dakṣa̭sya̱ sādha̭nam",
   "ya̱jñeṣṷ pū̱rvyaṃ gi̱rā praya̭svanto havāmahe"
  ],

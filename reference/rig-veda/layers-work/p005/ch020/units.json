  "line_ids": [
   "005.020.1a",
   "005.020.1b"
  ],
  "lines_deva": [
   "यम॑ग्ने वाजसातम॒ त्वं चि॒न् मन्य॑से र॒यिम्",
   "तं नो॑ गी॒र्भिः श्र॒वाय्यं॑ देव॒त्रा प॑नया॒ युज॑म्"
  ],
  "lines_iast": [
   "yama̭gne vājasātama̱ tvaṃ ci̱n manya̭se ra̱yim",
   "taṃ no̭ gī̱rbhiḥ śra̱vāyya̭ṃ deva̱trā pa̭nayā̱ yuja̭m"
  ],
  "book_split": [

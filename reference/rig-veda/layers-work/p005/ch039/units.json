 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.039.4a",
   "005.039.4b"
  ],
  "lines_deva": [
   "मंहि॑ष्ठं वो म॒घोनां॒ राजा॑नं चर्षणी॒नाम्",
   "इन्द्र॒मुप॒ प्रश॑स्तये पू॒र्वीभि॑र्जुजुषे॒ गिर॑:"
  ],
  "lines_iast": [
   "maṃhi̭ṣṭhaṃ vo ma̱ghonā̱ṃ rājā̭naṃ carṣaṇī̱nām",
   "indra̱mupa̱ praśa̭staye pū̱rvībhi̭rjujuṣe̱ gira̭:"
  ],

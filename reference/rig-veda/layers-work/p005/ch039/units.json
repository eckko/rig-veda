 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.039.1a",
   "005.039.1b"
  ],
  "lines_deva": [
   "यदि॑न्द्र चित्र मे॒हनास्ति॒ त्वादा॑तमद्रिवः",
   "राध॒स्तन्नो॑ विदद्वस उभयाह॒स्त्या भ॑र"
  ],
  "lines_iast": [
   "yadi̭ndra citra me̱hanāsti̱ tvādā̭tamadrivaḥ",
   "rādha̱stanno̭ vidadvasa ubhayāha̱styā bha̭ra"
  ],
  "book_split": [

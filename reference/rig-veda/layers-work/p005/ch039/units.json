  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.039.2a",
   "005.039.2b"
  ],
  "lines_deva": [
   "यन्मन्य॑से॒ वरे॑ण्य॒मिन्द्र॑ द्यु॒क्षं तदा भ॑र",
   "वि॒द्याम॒ तस्य॑ ते व॒यमकू॑पारस्य दा॒वने॑"
  ],
  "lines_iast": [
   "yanmanya̭se̱ varḙṇya̱mindra̭ dyu̱kṣaṃ tadā bha̭ra",
   "vi̱dyāma̱ tasya̭ te va̱yamakṷ̄pārasya dā̱vanḙ"
  ],

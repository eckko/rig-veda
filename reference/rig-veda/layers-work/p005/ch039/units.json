   "005.039.5a",
   "005.039.5b"
  ],
  "lines_deva": [
   "अस्मा॒ इत् काव्यं॒ वच॑ उ॒क्थमिन्द्रा॑य॒ शंस्य॑म्",
   "तस्मा॑ उ॒ ब्रह्म॑वाहसे॒ गिरो॑ वर्ध॒न्त्यत्र॑यो॒ गिर॑: शुम्भ॒न्त्यत्र॑यः"
  ],
  "lines_iast": [
   "asmā̱ it kāvya̱ṃ vaca̭ u̱kthamindrā̭ya̱ śaṃsya̭m",
   "tasmā̭ u̱ brahma̭vāhase̱ giro̭ vardha̱ntyatra̭yo̱ gira̭: śumbha̱ntyatra̭yaḥ"
  ],

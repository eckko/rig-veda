 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.039.3a",
   "005.039.3b"
  ],
  "lines_deva": [
   "यत् ते॑ दि॒त्सु प्र॒राध्यं॒ मनो॒ अस्ति॑ श्रु॒तं बृ॒हत्",
   "तेन॑ दृ॒ळहा चि॑दद्रिव॒ आ वाजं॑ दर्षि सा॒तये॑"
  ],
  "lines_iast": [
   "yat tḙ di̱tsu pra̱rādhya̱ṃ mano̱ asti̭ śru̱taṃ bṛ̱hat",
   "tena̭ dṛ̱ḻahā ci̭dadriva̱ ā vāja̭ṃ darṣi sā̱tayḙ"
  ],

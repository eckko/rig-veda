 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.035.2a",
   "005.035.2b"
  ],
  "lines_deva": [
   "यदि॑न्द्र ते॒ चत॑स्रो॒ यच्छू॑र॒ सन्ति॑ ति॒स्रः",
   "यद् वा॒ पञ्च॑ क्षिती॒नामव॒स्तत् सु न॒ आ भ॑र"
  ],
  "lines_iast": [
   "yadi̭ndra te̱ cata̭sro̱ yacchṷ̄ra̱ santi̭ ti̱sraḥ",
   "yad vā̱ pañca̭ kṣitī̱nāmava̱stat su na̱ ā bha̭ra"
  ],

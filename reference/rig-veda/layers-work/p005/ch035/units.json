[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.035.1a",
   "005.035.1b"
  ],
  "lines_deva": [
   "यस्ते॒ साधि॒ष्ठोऽव॑स॒ इन्द्र॒ क्रतु॒ष्टमा भ॑र",
   "अ॒स्मभ्यं॑ चर्षणी॒सहं॒ सस्निं॒ वाजे॑षु दु॒ष्टर॑म्"
  ],
  "lines_iast": [
   "yaste̱ sādhi̱ṣṭho'va̭sa̱ indra̱ kratu̱ṣṭamā bha̭ra",
   "a̱smabhya̭ṃ carṣaṇī̱saha̱ṃ sasni̱ṃ vājḙṣu du̱ṣṭara̭m"
  ],

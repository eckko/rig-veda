  "lines_deva": [
   "त्वं तमि॑न्द्र॒ मर्त्य॑ममित्र॒यन्त॑मद्रिवः",
   "स॒र्व॒र॒था श॑तक्रतो॒ नि या॑हि शवसस्पते"
  ],
  "lines_iast": [
   "tvaṃ tami̭ndra̱ martya̭mamitra̱yanta̭madrivaḥ",
   "sa̱rva̱ra̱thā śa̭takrato̱ ni yā̭hi śavasaspate"
  ],

   "005.035.4b"
  ],
  "lines_deva": [
   "वृषा॒ ह्यसि॒ राध॑से जज्ञि॒षे वृष्णि॑ ते॒ शव॑:",
   "स्वक्ष॑त्रं ते धृ॒षन्मन॑: सत्रा॒हमि॑न्द्र॒ पौंस्य॑म्"
  ],
  "lines_iast": [
   "vṛṣā̱ hyasi̱ rādha̭se jajñi̱ṣe vṛṣṇi̭ te̱ śava̭:",
   "svakṣa̭traṃ te dhṛ̱ṣanmana̭: satrā̱hami̭ndra̱ pauṃsya̭m"
  ],

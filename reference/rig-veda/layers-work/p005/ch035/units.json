   "005.035.3a",
   "005.035.3b"
  ],
  "lines_deva": [
   "आ तेऽवो॒ वरे॑ण्यं॒ वृष॑न्तमस्य हूमहे",
   "वृष॑जूति॒र्हि ज॑ज्ञि॒ष आ॒भूभि॑रिन्द्र तु॒र्वणि॑:"
  ],
  "lines_iast": [
   "ā te'vo̱ varḙṇya̱ṃ vṛṣa̭ntamasya hūmahe",
   "vṛṣa̭jūti̱rhi ja̭jñi̱ṣa ā̱bhūbhi̭rindra tu̱rvaṇi̭:"
  ],

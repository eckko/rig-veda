   "005.035.7b"
  ],
  "lines_deva": [
   "अ॒स्माक॑मिन्द्र दु॒ष्टरं॑ पुरो॒यावा॑नमा॒जिषु॑",
   "स॒यावा॑नं॒ धने॑धने वाज॒यन्त॑मवा॒ रथ॑म्"
  ],
  "lines_iast": [
   "a̱smāka̭mindra du̱ṣṭara̭ṃ puro̱yāvā̭namā̱jiṣṷ",
   "sa̱yāvā̭na̱ṃ dhanḙdhane vāja̱yanta̭mavā̱ ratha̭m"
  ],

  "lines_deva": [
   "त्वामिद् वृ॑त्रहन्तम॒ जना॑सो वृ॒क्तब॑र्हिषः",
   "उ॒ग्रं पू॒र्वीषु॑ पू॒र्व्यं हव॑न्ते॒ वाज॑सातये"
  ],
  "lines_iast": [
   "tvāmid vṛ̭trahantama̱ janā̭so vṛ̱ktaba̭rhiṣaḥ",
   "u̱graṃ pū̱rvīṣṷ pū̱rvyaṃ hava̭nte̱ vāja̭sātaye"
  ],

   "005.035.8b"
  ],
  "lines_deva": [
   "अ॒स्माक॑मि॒न्द्रेहि॑ नो॒ रथ॑मवा॒ पुरं॑ध्या",
   "व॒यं श॑विष्ठ॒ वार्यं॑ दि॒वि श्रवो॑ दधीमहि दि॒वि स्तोमं॑ मनामहे"
  ],
  "lines_iast": [
   "a̱smāka̭mi̱ndrehi̭ no̱ ratha̭mavā̱ pura̭ṃdhyā",
   "va̱yaṃ śa̭viṣṭha̱ vārya̭ṃ di̱vi śravo̭ dadhīmahi di̱vi stoma̭ṃ manāmahe"
  ],

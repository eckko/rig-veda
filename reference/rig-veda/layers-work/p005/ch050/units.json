  "lines_deva": [
   "विश्वो॑ दे॒वस्य॑ ने॒तुर्मर्तो॑ वुरीत स॒ख्यम्",
   "विश्वो॑ रा॒य इ॑षुध्यति द्यु॒म्नं वृ॑णीत पु॒ष्यसे॑"
  ],
  "lines_iast": [
   "viśvo̭ de̱vasya̭ ne̱turmarto̭ vurīta sa̱khyam",
   "viśvo̭ rā̱ya i̭ṣudhyati dyu̱mnaṃ vṛ̭ṇīta pu̱ṣyasḙ"
  ],

  "lines_deva": [
   "ए॒ष ते॑ देव नेता॒ रथ॒स्पति॒: शं र॒यिः",
   "शं रा॒ये शं स्व॒स्तय॑ इष॒:स्तुतो॑ मनामहे देव॒स्तुतो॑ मनामहे"
  ],
  "lines_iast": [
   "e̱ṣa tḙ deva netā̱ ratha̱spati̱: śaṃ ra̱yiḥ",
   "śaṃ rā̱ye śaṃ sva̱staya̭ iṣa̱:stuto̭ manāmahe deva̱stuto̭ manāmahe"
  ],

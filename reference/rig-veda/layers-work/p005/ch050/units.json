  "lines_deva": [
   "यत्र॒ वह्नि॑र॒भिहि॑तो दु॒द्रव॒द् द्रोण्य॑: प॒शुः",
   "नृ॒मणा॑ वी॒रप॒स्त्योऽर्णा॒ धीरे॑व॒ सनि॑ता"
  ],
  "lines_iast": [
   "yatra̱ vahni̭ra̱bhihi̭to du̱drava̱d droṇya̭: pa̱śuḥ",
   "nṛ̱maṇā̭ vī̱rapa̱styo'rṇā̱ dhīrḙva̱ sani̭tā"
  ],

   "005.050.2b"
  ],
  "lines_deva": [
   "ते ते॑ देव नेत॒र्ये चे॒माँ अ॑नु॒शसे॑",
   "ते रा॒या ते ह्या॒३पृचे॒ सचे॑महि सच॒थ्यै॑:"
  ],
  "lines_iast": [
   "te tḙ deva neta̱rye ce̱mā~ a̭nu̱śasḙ",
   "te rā̱yā te hyā̱3pṛce̱ sacḙmahi saca̱thyai̭:"
  ],

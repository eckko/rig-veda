  "lines_deva": [
   "अतो॑ न॒ आ नॄनति॑थी॒नत॒: पत्नी॑र्दशस्यत",
   "आ॒रे विश्वं॑ पथे॒ष्ठां द्वि॒षो यु॑योतु॒ यूयु॑विः"
  ],
  "lines_iast": [
   "ato̭ na̱ ā nṝnati̭thī̱nata̱: patnī̭rdaśasyata",
   "ā̱re viśva̭ṃ pathe̱ṣṭhāṃ dvi̱ṣo yṷyotu̱ yūyṷviḥ"
  ],

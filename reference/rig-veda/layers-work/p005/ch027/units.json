   " ।",
   " ॥"
  ]
 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.027.3a",
   "005.027.3b"
  ],
  "lines_deva": [
   "ए॒वा ते॑ अग्ने सुम॒तिं च॑का॒नो नवि॑ष्ठाय नव॒मं त्र॒सद॑स्युः",
   "यो मे॒ गिर॑स्तुविजा॒तस्य॑ पू॒र्वीर्यु॒क्तेना॒भि त्र्य॑रुणो गृ॒णाति॑"
  ],
  "lines_iast": [
   "e̱vā tḙ agne suma̱tiṃ ca̭kā̱no navi̭ṣṭhāya nava̱maṃ tra̱sada̭syuḥ",
   "yo me̱ gira̭stuvijā̱tasya̭ pū̱rvīryu̱ktenā̱bhi trya̭ruṇo gṛ̱ṇāti̭"
  ],
  "book_split": [

 },
 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.027.4a",
   "005.027.4b"
  ],
  "lines_deva": [
   "यो म॒ इति॑ प्र॒वोच॒त्यश्व॑मेधाय सू॒रये॑",
   "दद॑दृ॒चा स॒निं य॒ते दद॑न्मे॒धामृ॑ताय॒ते"
  ],
  "lines_iast": [
   "yo ma̱ iti̭ pra̱voca̱tyaśva̭medhāya sū̱rayḙ",
   "dada̭dṛ̱cā sa̱niṃ ya̱te dada̭nme̱dhāmṛ̭tāya̱te"
  ],

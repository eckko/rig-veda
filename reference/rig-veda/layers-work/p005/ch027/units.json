   "005.027.5b"
  ],
  "lines_deva": [
   "यस्य॑ मा परु॒षाः श॒तमु॑द्ध॒र्षय॑न्त्यु॒क्षण॑:",
   "अश्व॑मेधस्य॒ दाना॒: सोमा॑ इव॒ त्र्या॑शिरः"
  ],
  "lines_iast": [
   "yasya̭ mā paru̱ṣāḥ śa̱tamṷddha̱rṣaya̭ntyu̱kṣaṇa̭:",
   "aśva̭medhasya̱ dānā̱: somā̭ iva̱ tryā̭śiraḥ"
  ],

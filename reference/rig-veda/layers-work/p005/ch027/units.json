   "005.027.6b"
  ],
  "lines_deva": [
   "इन्द्रा॑ग्नी शत॒दाव्न्यश्व॑मेधे सु॒वीर्य॑म्",
   "क्ष॒त्रं धा॑रयतं बृ॒हद् दि॒वि सूर्य॑मिवा॒जर॑म्"
  ],
  "lines_iast": [
   "indrā̭gnī śata̱dāvnyaśva̭medhe su̱vīrya̭m",
   "kṣa̱traṃ dhā̭rayataṃ bṛ̱had di̱vi sūrya̭mivā̱jara̭m"
  ],

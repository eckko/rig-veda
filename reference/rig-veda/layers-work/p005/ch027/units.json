[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.027.1a",
   "005.027.1b"
  ],
  "lines_deva": [
   "अन॑स्वन्ता॒ सत्प॑तिर्मामहे मे॒ गावा॒ चेति॑ष्ठो॒ असु॑रो म॒घोन॑:",
   "त्रै॒वृ॒ष्णो अ॑ग्ने द॒शभि॑: स॒हस्रै॒र्वैश्वा॑नर॒ त्र्य॑रुणश्चिकेत"
  ],
  "lines_iast": [
   "ana̭svantā̱ satpa̭tirmāmahe me̱ gāvā̱ ceti̭ṣṭho̱ asṷro ma̱ghona̭:",
   "trai̱vṛ̱ṣṇo a̭gne da̱śabhi̭: sa̱hasrai̱rvaiśvā̭nara̱ trya̭ruṇaściketa"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
   "",
   ""
  ],
  "book_english": [
   "",
   ""
  ],
  "uncertain": [],
  "trailers": [
   " ।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.027.2a",
   "005.027.2b"
  ],
  "lines_deva": [
   "यो मे॑ श॒ता च॑ विंश॒तिं च॒ गोनां॒ हरी॑ च यु॒क्ता सु॒धुरा॒ ददा॑ति",
   "वैश्वा॑नर॒ सुष्टु॑तो वावृधा॒नोऽग्ने॒ यच्छ॒ त्र्य॑रुणाय॒ शर्म॑"
  ],
  "lines_iast": [
   "yo mḙ śa̱tā ca̭ viṃśa̱tiṃ ca̱ gonā̱ṃ harī̭ ca yu̱ktā su̱dhurā̱ dadā̭ti",
   "vaiśvā̭nara̱ suṣṭṷto vāvṛdhā̱no'gne̱ yaccha̱ trya̭ruṇāya̱ śarma̭"
  ],
  "book_split": [
   "",

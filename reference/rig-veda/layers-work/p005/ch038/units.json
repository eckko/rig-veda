  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.038.2a",
   "005.038.2b"
  ],
  "lines_deva": [
   "यदी॑मिन्द्र श्र॒वाय्य॒मिषं॑ शविष्ठ दधि॒षे",
   "प॒प्र॒थे दी॑र्घ॒श्रुत्त॑मं॒ हिर॑ण्यवर्ण दु॒ष्टर॑म्"
  ],
  "lines_iast": [
   "yadī̭mindra śra̱vāyya̱miṣa̭ṃ śaviṣṭha dadhi̱ṣe",
   "pa̱pra̱the dī̭rgha̱śrutta̭ma̱ṃ hira̭ṇyavarṇa du̱ṣṭara̭m"
  ],
  "book_split": [

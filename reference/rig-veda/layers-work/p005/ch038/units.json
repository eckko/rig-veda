   "005.038.1a",
   "005.038.1b"
  ],
  "lines_deva": [
   "उ॒रोष्ट॑ इन्द्र॒ राध॑सो वि॒भ्वी रा॒तिः श॑तक्रतो",
   "अधा॑ नो विश्वचर्षणे द्यु॒म्ना सु॑क्षत्र मंहय"
  ],
  "lines_iast": [
   "u̱roṣṭa̭ indra̱ rādha̭so vi̱bhvī rā̱tiḥ śa̭takrato",
   "adhā̭ no viśvacarṣaṇe dyu̱mnā sṷkṣatra maṃhaya"
  ],
  "book_split": [

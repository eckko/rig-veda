   "005.038.4b"
  ],
  "lines_deva": [
   "उ॒तो नो॑ अ॒स्य कस्य॑ चि॒द् दक्ष॑स्य॒ तव॑ वृत्रहन्",
   "अ॒स्मभ्यं॑ नृ॒म्णमा भ॑रा॒ऽस्मभ्यं॑ नृमणस्यसे"
  ],
  "lines_iast": [
   "u̱to no̭ a̱sya kasya̭ ci̱d dakṣa̭sya̱ tava̭ vṛtrahan",
   "a̱smabhya̭ṃ nṛ̱mṇamā bha̭rā̱'smabhya̭ṃ nṛmaṇasyase"
  ],

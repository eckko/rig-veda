   "005.038.3a",
   "005.038.3b"
  ],
  "lines_deva": [
   "शुष्मा॑सो॒ ये ते॑ अद्रिवो मे॒हना॑ केत॒साप॑:",
   "उ॒भा दे॒वाव॒भिष्ट॑ये दि॒वश्च॒ ग्मश्च॑ राजथः"
  ],
  "lines_iast": [
   "śuṣmā̭so̱ ye tḙ adrivo me̱hanā̭ keta̱sāpa̭:",
   "u̱bhā de̱vāva̱bhiṣṭa̭ye di̱vaśca̱ gmaśca̭ rājathaḥ"
  ],

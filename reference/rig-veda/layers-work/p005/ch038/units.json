   "005.038.5b"
  ],
  "lines_deva": [
   "नू त॑ आ॒भिर॒भिष्टि॑भि॒स्तव॒ शर्म॑ञ्छतक्रतो",
   "इन्द्र॒ स्याम॑ सुगो॒पाः शूर॒ स्याम॑ सुगो॒पाः"
  ],
  "lines_iast": [
   "nū ta̭ ā̱bhira̱bhiṣṭi̭bhi̱stava̱ śarma̭ñchatakrato",
   "indra̱ syāma̭ sugo̱pāḥ śūra̱ syāma̭ sugo̱pāḥ"
  ],

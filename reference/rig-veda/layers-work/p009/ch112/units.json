 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "009.112.2a",
   "009.112.2b"
  ],
  "lines_deva": [
   "जर॑तीभि॒रोष॑धीभिः प॒र्णेभि॑: शकु॒नाना॑म्",
   "का॒र्मा॒रो अश्म॑भि॒र्द्युभि॒र्हिर॑ण्यवन्तमिच्छ॒तीन्द्रा॑येन्दो॒ परि॑ स्रव"
  ],
  "lines_iast": [
   "jara̭tībhi̱roṣa̭dhībhiḥ pa̱rṇebhi̭: śaku̱nānā̭m",
   "kā̱rmā̱ro aśma̭bhi̱rdyubhi̱rhira̭ṇyavantamiccha̱tīndrā̭yendo̱ pari̭ srava"
  ],

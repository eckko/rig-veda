 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "009.112.3a",
   "009.112.3b"
  ],
  "lines_deva": [
   "का॒रुर॒हं त॒तो भि॒षगु॑पलप्र॒क्षिणी॑ न॒ना",
   "नाना॑धियो वसू॒यवोऽनु॒ गा इ॑व तस्थि॒मेन्द्रा॑येन्दो॒ परि॑ स्रव"
  ],
  "lines_iast": [
   "kā̱rura̱haṃ ta̱to bhi̱ṣagṷpalapra̱kṣiṇī̭ na̱nā",
   "nānā̭dhiyo vasū̱yavo'nu̱ gā i̭va tasthi̱mendrā̭yendo̱ pari̭ srava"
  ],

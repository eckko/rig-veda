   "009.112.4a",
   "009.112.4b"
  ],
  "lines_deva": [
   "अश्वो॒ वोळ्हा॑ सु॒खं रथं॑ हस॒नामु॑पम॒न्त्रिण॑:",
   "शेपो॒ रोम॑ण्वन्तौ भे॒दौ वारिन्म॒ण्डूक॑ इच्छ॒तीन्द्रा॑येन्दो॒ परि॑ स्रव"
  ],
  "lines_iast": [
   "aśvo̱ voḻhā̭ su̱khaṃ ratha̭ṃ hasa̱nāmṷpama̱ntriṇa̭:",
   "śepo̱ roma̭ṇvantau bhe̱dau vārinma̱ṇḍūka̭ iccha̱tīndrā̭yendo̱ pari̭ srava"
  ],

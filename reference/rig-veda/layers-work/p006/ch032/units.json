 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.032.2a",
   "006.032.2b"
  ],
  "lines_deva": [
   "स मा॒तरा॒ सूर्ये॑णा कवी॒नामवा॑सयद्रु॒जदद्रिं॑ गृणा॒नः",
   "स्वा॒धीभि॒ॠक्व॑भिर्वावशा॒न उदु॒स्रिया॑णामसृजन्नि॒दान॑म्"
  ],
  "lines_iast": [
   "sa mā̱tarā̱ sūryḙṇā kavī̱nāmavā̭sayadru̱jadadri̭ṃ gṛṇā̱naḥ",
   "svā̱dhībhi̱ṝkva̭bhirvāvaśā̱na udu̱sriyā̭ṇāmasṛjanni̱dāna̭m"
  ],
  "book_split": [

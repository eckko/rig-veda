 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.032.3a",
   "006.032.3b"
  ],
  "lines_deva": [
   "स वह्नि॑भि॒ॠक्व॑भि॒र्गोषु॒ शश्व॑न्मि॒तज्ञु॑भिः पुरु॒कृत्वा॑ जिगाय",
   "पुर॑: पुरो॒हा सखि॑भिः सखी॒यन्दृ॒ळ्हा रु॑रोज क॒विभि॑: क॒विः सन्"
  ],
  "lines_iast": [
   "sa vahni̭bhi̱ṝkva̭bhi̱rgoṣu̱ śaśva̭nmi̱tajñṷbhiḥ puru̱kṛtvā̭ jigāya",
   "pura̭: puro̱hā sakhi̭bhiḥ sakhī̱yandṛ̱ḻhā rṷroja ka̱vibhi̭: ka̱viḥ san"
  ],

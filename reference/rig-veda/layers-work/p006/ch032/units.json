 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "006.032.4a",
   "006.032.4b"
  ],
  "lines_deva": [
   "स नी॒व्या॑भिर्जरि॒तार॒मच्छा॑ म॒हो वाजे॑भिर्म॒हद्भि॑श्च॒ शुष्मै॑:",
   "पु॒रु॒वीरा॑भिर्वृषभ क्षिती॒नामा गि॑र्वणः सुवि॒ताय॒ प्र या॑हि"
  ],
  "lines_iast": [
   "sa nī̱vyā̭bhirjari̱tāra̱macchā̭ ma̱ho vājḙbhirma̱hadbhi̭śca̱ śuṣmai̭:",
   "pu̱ru̱vīrā̭bhirvṛṣabha kṣitī̱nāmā gi̭rvaṇaḥ suvi̱tāya̱ pra yā̭hi"
  ],

  "line_ids": [
   "006.032.1a",
   "006.032.1b"
  ],
  "lines_deva": [
   "अपू॑र्व्या पुरु॒तमा॑न्यस्मै म॒हे वी॒राय॑ त॒वसे॑ तु॒राय॑",
   "वि॒र॒प्शिने॑ व॒ज्रिणे॒ शंत॑मानि॒ वचां॑स्या॒सा स्थवि॑राय तक्षम्"
  ],
  "lines_iast": [
   "apṷ̄rvyā puru̱tamā̭nyasmai ma̱he vī̱rāya̭ ta̱vasḙ tu̱rāya̭",
   "vi̱ra̱pśinḙ va̱jriṇe̱ śaṃta̭māni̱ vacā̭ṃsyā̱sā sthavi̭rāya takṣam"
  ],

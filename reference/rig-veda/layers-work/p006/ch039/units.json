   "006.039.1a",
   "006.039.1b"
  ],
  "lines_deva": [
   "म॒न्द्रस्य॑ क॒वेर्दि॒व्यस्य॒ वह्ने॒र्विप्र॑मन्मनो वच॒नस्य॒ मध्व॑:",
   "अपा॑ न॒स्तस्य॑ सच॒नस्य॑ दे॒वेषो॑ युवस्व गृण॒ते गोअ॑ग्राः"
  ],
  "lines_iast": [
   "ma̱ndrasya̭ ka̱verdi̱vyasya̱ vahne̱rvipra̭manmano vaca̱nasya̱ madhva̭:",
   "apā̭ na̱stasya̭ saca̱nasya̭ de̱veṣo̭ yuvasva gṛṇa̱te goa̭grāḥ"
  ],

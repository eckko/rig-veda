   "006.039.5a",
   "006.039.5b"
  ],
  "lines_deva": [
   "नू गृ॑णा॒नो गृ॑ण॒ते प्र॑त्न राज॒न्निष॑: पिन्व वसु॒देया॑य पू॒र्वीः",
   "अ॒प ओष॑धीरवि॒षा वना॑नि॒ गा अर्व॑तो॒ नॄनृ॒चसे॑ रिरीहि"
  ],
  "lines_iast": [
   "nū gṛ̭ṇā̱no gṛ̭ṇa̱te pra̭tna rāja̱nniṣa̭: pinva vasu̱deyā̭ya pū̱rvīḥ",
   "a̱pa oṣa̭dhīravi̱ṣā vanā̭ni̱ gā arva̭to̱ nṝnṛ̱casḙ rirīhi"
  ],

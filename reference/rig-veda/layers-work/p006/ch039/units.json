 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "006.039.4a",
   "006.039.4b"
  ],
  "lines_deva": [
   "अ॒यं रो॑चयद॒रुचो॑ रुचा॒नो॒३ऽयं वा॑सय॒द्व्यृ१तेन॑ पू॒र्वीः",
   "अ॒यमी॑यत ऋत॒युग्भि॒रश्वै॑: स्व॒र्विदा॒ नाभि॑ना चर्षणि॒प्राः"
  ],
  "lines_iast": [
   "a̱yaṃ ro̭cayada̱ruco̭ rucā̱no̱3'yaṃ vā̭saya̱dvyṛ1tena̭ pū̱rvīḥ",
   "a̱yamī̭yata ṛta̱yugbhi̱raśvai̭: sva̱rvidā̱ nābhi̭nā carṣaṇi̱prāḥ"
  ],

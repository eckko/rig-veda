 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.039.3a",
   "006.039.3b"
  ],
  "lines_deva": [
   "अ॒यं द्यो॑तयद॒द्युतो॒ व्य१क्तून्दो॒षा वस्तो॑: श॒रद॒ इन्दु॑रिन्द्र",
   "इ॒मं के॒तुम॑दधु॒र्नू चि॒दह्नां॒ शुचि॑जन्मन उ॒षस॑श्चकार"
  ],
  "lines_iast": [
   "a̱yaṃ dyo̭tayada̱dyuto̱ vya1ktūndo̱ṣā vasto̭: śa̱rada̱ indṷrindra",
   "i̱maṃ ke̱tuma̭dadhu̱rnū ci̱dahnā̱ṃ śuci̭janmana u̱ṣasa̭ścakāra"
  ],

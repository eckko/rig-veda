 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.039.2a",
   "006.039.2b"
  ],
  "lines_deva": [
   "अ॒यमु॑शा॒नः पर्यद्रि॑मु॒स्रा ऋ॒तधी॑तिभिॠत॒युग्यु॑जा॒नः",
   "रु॒जदरु॑ग्णं॒ वि व॒लस्य॒ सानुं॑ प॒णीँर्वचो॑भिर॒भि यो॑ध॒दिन्द्र॑:"
  ],
  "lines_iast": [
   "a̱yamṷśā̱naḥ paryadri̭mu̱srā ṛ̱tadhī̭tibhiṝta̱yugyṷjā̱naḥ",
   "ru̱jadarṷgṇa̱ṃ vi va̱lasya̱ sānṷṃ pa̱ṇī~rvaco̭bhira̱bhi yo̭dha̱dindra̭:"
  ],

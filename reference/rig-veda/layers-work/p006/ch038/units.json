 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.038.3a",
   "006.038.3b"
  ],
  "lines_deva": [
   "तं वो॑ धि॒या प॑र॒मया॑ पुरा॒जाम॒जर॒मिन्द्र॑म॒भ्य॑नूष्य॒र्कैः",
   "ब्रह्मा॑ च॒ गिरो॑ दधि॒रे सम॑स्मिन्म॒हाँश्च॒ स्तोमो॒ अधि॑ वर्ध॒दिन्द्रे॑"
  ],
  "lines_iast": [
   "taṃ vo̭ dhi̱yā pa̭ra̱mayā̭ purā̱jāma̱jara̱mindra̭ma̱bhya̭nūṣya̱rkaiḥ",
   "brahmā̭ ca̱ giro̭ dadhi̱re sama̭sminma̱hā~śca̱ stomo̱ adhi̭ vardha̱dindrḙ"
  ],

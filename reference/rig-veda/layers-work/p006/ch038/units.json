   "006.038.5b"
  ],
  "lines_deva": [
   "ए॒वा ज॑ज्ञा॒नं सह॑से॒ असा॑मि वावृधा॒नं राध॑से च श्रु॒ताय॑",
   "म॒हामु॒ग्रमव॑से विप्र नू॒नमा वि॑वासेम वृत्र॒तूर्ये॑षु"
  ],
  "lines_iast": [
   "e̱vā ja̭jñā̱naṃ saha̭se̱ asā̭mi vāvṛdhā̱naṃ rādha̭se ca śru̱tāya̭",
   "ma̱hāmu̱gramava̭se vipra nū̱namā vi̭vāsema vṛtra̱tūryḙṣu"
  ],

   "006.038.2b"
  ],
  "lines_deva": [
   "दू॒राच्चि॒दा व॑सतो अस्य॒ कर्णा॒ घोषा॒दिन्द्र॑स्य तन्यति ब्रुवा॒णः",
   "एयमे॑नं दे॒वहू॑तिर्ववृत्यान्म॒द्र्य१गिन्द्र॑मि॒यमृ॒च्यमा॑ना"
  ],
  "lines_iast": [
   "dū̱rācci̱dā va̭sato asya̱ karṇā̱ ghoṣā̱dindra̭sya tanyati bruvā̱ṇaḥ",
   "eyamḙnaṃ de̱vahṷ̄tirvavṛtyānma̱drya1gindra̭mi̱yamṛ̱cyamā̭nā"
  ],

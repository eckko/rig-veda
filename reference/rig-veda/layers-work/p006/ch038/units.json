   "006.038.4a",
   "006.038.4b"
  ],
  "lines_deva": [
   "वर्धा॒द्यं य॒ज्ञ उ॒त सोम॒ इन्द्रं॒ वर्धा॒द्ब्रह्म॒ गिर॑ उ॒क्था च॒ मन्म॑",
   "वर्धाहै॑नमु॒षसो॒ याम॑न्न॒क्तोर्वर्धा॒न्मासा॑: श॒रदो॒ द्याव॒ इन्द्र॑म्"
  ],
  "lines_iast": [
   "vardhā̱dyaṃ ya̱jña u̱ta soma̱ indra̱ṃ vardhā̱dbrahma̱ gira̭ u̱kthā ca̱ manma̭",
   "vardhāhai̭namu̱ṣaso̱ yāma̭nna̱ktorvardhā̱nmāsā̭: śa̱rado̱ dyāva̱ indra̭m"
  ],

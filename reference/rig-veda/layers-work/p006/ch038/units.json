   "006.038.1b"
  ],
  "lines_deva": [
   "अपा॑दि॒त उदु॑ नश्चि॒त्रत॑मो म॒हीं भ॑र्षद्द्यु॒मती॒मिन्द्र॑हूतिम्",
   "पन्य॑सीं धी॒तिं दैव्य॑स्य॒ याम॒ञ्जन॑स्य रा॒तिं व॑नते सु॒दानु॑:"
  ],
  "lines_iast": [
   "apā̭di̱ta udṷ naści̱trata̭mo ma̱hīṃ bha̭rṣaddyu̱matī̱mindra̭hūtim",
   "panya̭sīṃ dhī̱tiṃ daivya̭sya̱ yāma̱ñjana̭sya rā̱tiṃ va̭nate su̱dānṷ:"
  ],

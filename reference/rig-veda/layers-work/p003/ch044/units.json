   "003.044.4a",
   "003.044.4b"
  ],
  "lines_deva": [
   "ज॒ज्ञा॒नो हरि॑तो॒ वृषा॒ विश्व॒मा भा॑ति रोच॒नम्",
   "हर्य॑श्वो॒ हरि॑तं धत्त॒ आयु॑ध॒मा वज्रं॑ बा॒ह्वोर्हरि॑म्"
  ],
  "lines_iast": [
   "ja̱jñā̱no hari̭to̱ vṛṣā̱ viśva̱mā bhā̭ti roca̱nam",
   "harya̭śvo̱ hari̭taṃ dhatta̱ āyṷdha̱mā vajra̭ṃ bā̱hvorhari̭m"
  ],

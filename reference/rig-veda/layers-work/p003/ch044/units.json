 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.044.2a",
   "003.044.2b"
  ],
  "lines_deva": [
   "ह॒र्यन्नु॒षस॑मर्चय॒: सूर्यं॑ ह॒र्यन्न॑रोचयः",
   "वि॒द्वाँश्चि॑कि॒त्वान् ह॑र्यश्व वर्धस॒ इन्द्र॒ विश्वा॑ अ॒भि श्रिय॑:"
  ],
  "lines_iast": [
   "ha̱ryannu̱ṣasa̭marcaya̱: sūrya̭ṃ ha̱ryanna̭rocayaḥ",
   "vi̱dvā~ści̭ki̱tvān ha̭ryaśva vardhasa̱ indra̱ viśvā̭ a̱bhi śriya̭:"
  ],

  "lines_deva": [
   "इन्द्रो॑ ह॒र्यन्त॒मर्जु॑नं॒ वज्रं॑ शु॒क्रैर॒भीवृ॑तम्",
   "अपा॑वृणो॒द्धरि॑भि॒रद्रि॑भिः सु॒तमुद् गा हरि॑भिराजत"
  ],
  "lines_iast": [
   "indro̭ ha̱ryanta̱marjṷna̱ṃ vajra̭ṃ śu̱kraira̱bhīvṛ̭tam",
   "apā̭vṛṇo̱ddhari̭bhi̱radri̭bhiḥ su̱tamud gā hari̭bhirājata"
  ],

   "003.044.3b"
  ],
  "lines_deva": [
   "द्यामिन्द्रो॒ हरि॑धायसं पृथि॒वीं हरि॑वर्पसम्",
   "अधा॑रयद्ध॒रितो॒र्भूरि॒ भोज॑नं॒ ययो॑र॒न्तर्हरि॒श्चर॑त्"
  ],
  "lines_iast": [
   "dyāmindro̱ hari̭dhāyasaṃ pṛthi̱vīṃ hari̭varpasam",
   "adhā̭rayaddha̱rito̱rbhūri̱ bhoja̭na̱ṃ yayo̭ra̱ntarhari̱ścara̭t"
  ],

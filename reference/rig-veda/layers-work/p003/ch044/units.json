   "003.044.1a",
   "003.044.1b"
  ],
  "lines_deva": [
   "अ॒यं ते॑ अस्तु हर्य॒तः सोम॒ आ हरि॑भिः सु॒तः",
   "जु॒षा॒ण इ॑न्द्र॒ हरि॑भिर्न॒ आ ग॒ह्या ति॑ष्ठ॒ हरि॑तं॒ रथ॑म्"
  ],
  "lines_iast": [
   "a̱yaṃ tḙ astu harya̱taḥ soma̱ ā hari̭bhiḥ su̱taḥ",
   "ju̱ṣā̱ṇa i̭ndra̱ hari̭bhirna̱ ā ga̱hyā ti̭ṣṭha̱ hari̭ta̱ṃ ratha̭m"
  ],

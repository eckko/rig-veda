  "lines_deva": [
   "स॒सृ॒वांस॑मिव॒ त्मना॒ ऽग्निमि॒त्था ति॒रोहि॑तम्",
   "ऐनं॑ नयन्मात॒रिश्वा॑ परा॒वतो॑ दे॒वेभ्यो॑ मथि॒तं परि॑"
  ],
  "lines_iast": [
   "sa̱sṛ̱vāṃsa̭miva̱ tmanā̱ 'gnimi̱tthā ti̱rohi̭tam",
   "aina̭ṃ nayanmāta̱riśvā̭ parā̱vato̭ de̱vebhyo̭ mathi̱taṃ pari̭"
  ],
  "book_split": [

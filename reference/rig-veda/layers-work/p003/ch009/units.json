  "lines_deva": [
   "तद् भ॒द्रं तव॑ दं॒सना॒ पाका॑य चिच्छदयति",
   "त्वां यद॑ग्ने प॒शव॑: स॒मास॑ते॒ समि॑द्धमपिशर्व॒रे"
  ],
  "lines_iast": [
   "tad bha̱draṃ tava̭ da̱ṃsanā̱ pākā̭ya cicchadayati",
   "tvāṃ yada̭gne pa̱śava̭: sa̱māsa̭te̱ sami̭ddhamapiśarva̱re"
  ],

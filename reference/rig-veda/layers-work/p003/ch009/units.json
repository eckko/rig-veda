   "003.009.9b"
  ],
  "lines_deva": [
   "त्रीणि॑ श॒ता त्री स॒हस्रा॑ण्य॒ग्निं त्रिं॒शच्च॑ दे॒वा नव॑ चासपर्यन्",
   "औक्ष॑न् घृ॒तैरस्तृ॑णन् ब॒र्हिर॑स्मा॒ आदिद्धोता॑रं॒ न्य॑सादयन्त"
  ],
  "lines_iast": [
   "trīṇi̭ śa̱tā trī sa̱hasrā̭ṇya̱gniṃ tri̱ṃśacca̭ de̱vā nava̭ cāsaparyan",
   "aukṣa̭n ghṛ̱tairastṛ̭ṇan ba̱rhira̭smā̱ ādiddhotā̭ra̱ṃ nya̭sādayanta"
  ],

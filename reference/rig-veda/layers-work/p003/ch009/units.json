  "lines_deva": [
   "ई॒यि॒वांस॒मति॒ स्रिध॒: शश्व॑ती॒रति॑ स॒श्चत॑:",
   "अन्वी॑मविन्दन् निचि॒रासो॑ अ॒द्रुहो॒ऽप्सु सिं॒हमि॑व श्रि॒तम्"
  ],
  "lines_iast": [
   "ī̱yi̱vāṃsa̱mati̱ sridha̱: śaśva̭tī̱rati̭ sa̱ścata̭:",
   "anvī̭mavindan nici̱rāso̭ a̱druho̱'psu si̱ṃhami̭va śri̱tam"
  ],

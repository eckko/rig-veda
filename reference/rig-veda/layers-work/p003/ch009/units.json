   "003.009.3b"
  ],
  "lines_deva": [
   "अति॑ तृ॒ष्टं व॑वक्षि॒थाथै॒व सु॒मना॑ असि",
   "प्रप्रा॒न्ये यन्ति॒ पर्य॒न्य आ॑सते॒ येषां॑ स॒ख्ये असि॑ श्रि॒तः"
  ],
  "lines_iast": [
   "ati̭ tṛ̱ṣṭaṃ va̭vakṣi̱thāthai̱va su̱manā̭ asi",
   "praprā̱nye yanti̱ parya̱nya ā̭sate̱ yeṣā̭ṃ sa̱khye asi̭ śri̱taḥ"
  ],

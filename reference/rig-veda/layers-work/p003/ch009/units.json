   "003.009.1a",
   "003.009.1b"
  ],
  "lines_deva": [
   "सखा॑यस्त्वा ववृमहे दे॒वं मर्ता॑स ऊ॒तये॑",
   "अ॒पां नपा॑तं सु॒भगं॑ सु॒दीदि॑तिं सु॒प्रतू॑र्तिमने॒हस॑म्"
  ],
  "lines_iast": [
   "sakhā̭yastvā vavṛmahe de̱vaṃ martā̭sa ū̱tayḙ",
   "a̱pāṃ napā̭taṃ su̱bhaga̭ṃ su̱dīdi̭tiṃ su̱pratṷ̄rtimane̱hasa̭m"
  ],
  "book_split": [

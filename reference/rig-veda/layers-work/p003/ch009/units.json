  "lines_deva": [
   "आ जु॑होता स्वध्व॒रं शी॒रं पा॑व॒कशो॑चिषम्",
   "आ॒शुं दू॒तम॑जि॒रं प्र॒त्नमीड्यं॑ श्रु॒ष्टी दे॒वं स॑पर्यत"
  ],
  "lines_iast": [
   "ā jṷhotā svadhva̱raṃ śī̱raṃ pā̭va̱kaśo̭ciṣam",
   "ā̱śuṃ dū̱tama̭ji̱raṃ pra̱tnamīḍya̭ṃ śru̱ṣṭī de̱vaṃ sa̭paryata"
  ],

   "003.009.2a",
   "003.009.2b"
  ],
  "lines_deva": [
   "काय॑मानो व॒ना त्वं यन्मा॒तॄरज॑गन्न॒पः",
   "न तत् ते॑ अग्ने प्र॒मृषे॑ नि॒वर्त॑नं॒ यद् दू॒रे सन्नि॒हाभ॑वः"
  ],
  "lines_iast": [
   "kāya̭māno va̱nā tvaṃ yanmā̱tṝraja̭ganna̱paḥ",
   "na tat tḙ agne pra̱mṛṣḙ ni̱varta̭na̱ṃ yad dū̱re sanni̱hābha̭vaḥ"
  ],

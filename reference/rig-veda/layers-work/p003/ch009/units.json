   "003.009.6a",
   "003.009.6b"
  ],
  "lines_deva": [
   "तं त्वा॒ मर्ता॑ अगृभ्णत दे॒वेभ्यो॑ हव्यवाहन",
   "विश्वा॒न् यद् य॒ज्ञाँ अ॑भि॒पासि॑ मानुष॒ तव॒ क्रत्वा॑ यविष्ठ्य"
  ],
  "lines_iast": [
   "taṃ tvā̱ martā̭ agṛbhṇata de̱vebhyo̭ havyavāhana",
   "viśvā̱n yad ya̱jñā~ a̭bhi̱pāsi̭ mānuṣa̱ tava̱ kratvā̭ yaviṣṭhya"
  ],

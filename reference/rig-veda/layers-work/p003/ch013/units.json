 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "003.013.6a",
   "003.013.6b"
  ],
  "lines_deva": [
   "उ॒त नो॒ ब्रह्म॑न्नविष उ॒क्थेषु॑ देव॒हूत॑मः",
   "शं न॑: शोचा म॒रुद्वृ॒धोऽग्ने॑ सहस्र॒सात॑मः"
  ],
  "lines_iast": [
   "u̱ta no̱ brahma̭nnaviṣa u̱ktheṣṷ deva̱hūta̭maḥ",
   "śaṃ na̭: śocā ma̱rudvṛ̱dho'gnḙ sahasra̱sāta̭maḥ"
  ],

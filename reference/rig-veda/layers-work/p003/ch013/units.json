[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "003.013.1a",
   "003.013.1b"
  ],
  "lines_deva": [
   "प्र वो॑ दे॒वाया॒ग्नये॒ बर्हि॑ष्ठमर्चास्मै",
   "गम॑द् दे॒वेभि॒रा स नो॒ यजि॑ष्ठो ब॒र्हिरा स॑दत्"
  ],
  "lines_iast": [
   "pra vo̭ de̱vāyā̱gnaye̱ barhi̭ṣṭhamarcāsmai",
   "gama̭d de̱vebhi̱rā sa no̱ yaji̭ṣṭho ba̱rhirā sa̭dat"
  ],
  "book_split": [

   "003.013.7b"
  ],
  "lines_deva": [
   "नू नो॑ रास्व स॒हस्र॑वत् तो॒कव॑त्पुष्टि॒मद् वसु॑",
   "द्यु॒मद॑ग्ने सु॒वीर्यं॒ वर्षि॑ष्ठ॒मनु॑पक्षितम्"
  ],
  "lines_iast": [
   "nū no̭ rāsva sa̱hasra̭vat to̱kava̭tpuṣṭi̱mad vasṷ",
   "dyu̱mada̭gne su̱vīrya̱ṃ varṣi̭ṣṭha̱manṷpakṣitam"
  ],

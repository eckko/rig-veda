 },
 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.013.4a",
   "003.013.4b"
  ],
  "lines_deva": [
   "स न॒: शर्मा॑णि वी॒तये॒ऽग्निर्य॑च्छतु॒ शंत॑मा",
   "यतो॑ नः प्रु॒ष्णव॒द् वसु॑ दि॒वि क्षि॒तिभ्यो॑ अ॒प्स्वा"
  ],
  "lines_iast": [
   "sa na̱: śarmā̭ṇi vī̱taye̱'gnirya̭cchatu̱ śaṃta̭mā",
   "yato̭ naḥ pru̱ṣṇava̱d vasṷ di̱vi kṣi̱tibhyo̭ a̱psvā"
  ],
  "book_split": [
   "",

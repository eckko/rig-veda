 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "003.013.5a",
   "003.013.5b"
  ],
  "lines_deva": [
   "दी॒दि॒वांस॒मपू॑र्व्यं॒ वस्वी॑भिरस्य धी॒तिभि॑:",
   "ऋक्वा॑णो अ॒ग्निमि॑न्धते॒ होता॑रं वि॒श्पतिं॑ वि॒शाम्"
  ],
  "lines_iast": [
   "dī̱di̱vāṃsa̱mapṷ̄rvya̱ṃ vasvī̭bhirasya dhī̱tibhi̭:",
   "ṛkvā̭ṇo a̱gnimi̭ndhate̱ hotā̭raṃ vi̱śpati̭ṃ vi̱śām"
  ],

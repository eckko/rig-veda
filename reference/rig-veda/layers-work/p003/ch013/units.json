 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.013.3a",
   "003.013.3b"
  ],
  "lines_deva": [
   "स य॒न्ता विप्र॑ एषां॒ स य॒ज्ञाना॒मथा॒ हि षः",
   "अ॒ग्निं तं वो॑ दुवस्यत॒ दाता॒ यो वनि॑ता म॒घम्"
  ],
  "lines_iast": [
   "sa ya̱ntā vipra̭ eṣā̱ṃ sa ya̱jñānā̱mathā̱ hi ṣaḥ",
   "a̱gniṃ taṃ vo̭ duvasyata̱ dātā̱ yo vani̭tā ma̱gham"
  ],
  "book_split": [

 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.013.2a",
   "003.013.2b"
  ],
  "lines_deva": [
   "ऋ॒तावा॒ यस्य॒ रोद॑सी॒ दक्षं॒ सच॑न्त ऊ॒तय॑:",
   "ह॒विष्म॑न्त॒स्तमी॑ळते॒ तं स॑नि॒ष्यन्तोऽव॑से"
  ],
  "lines_iast": [
   "ṛ̱tāvā̱ yasya̱ roda̭sī̱ dakṣa̱ṃ saca̭nta ū̱taya̭:",
   "ha̱viṣma̭nta̱stamī̭ḻate̱ taṃ sa̭ni̱ṣyanto'va̭se"
  ],
  "book_split": [

 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.096.3a",
   "007.096.3b"
  ],
  "lines_deva": [
   "भ॒द्रमिद्भ॒द्रा कृ॑णव॒त्सर॑स्व॒त्यक॑वारी चेतति वा॒जिनी॑वती",
   "गृ॒णा॒ना ज॑मदग्नि॒वत्स्तु॑वा॒ना च॑ वसिष्ठ॒वत्"
  ],
  "lines_iast": [
   "bha̱dramidbha̱drā kṛ̭ṇava̱tsara̭sva̱tyaka̭vārī cetati vā̱jinī̭vatī",
   "gṛ̱ṇā̱nā ja̭madagni̱vatstṷvā̱nā ca̭ vasiṣṭha̱vat"
  ],
  "book_split": [

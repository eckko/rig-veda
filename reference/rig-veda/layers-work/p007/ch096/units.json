  "line_ids": [
   "007.096.1a",
   "007.096.1b"
  ],
  "lines_deva": [
   "बृ॒हदु॑ गायिषे॒ वचो॑ऽसु॒र्या॑ न॒दीना॑म्",
   "सर॑स्वती॒मिन्म॑हया सुवृ॒क्तिभि॒: स्तोमै॑र्वसिष्ठ॒ रोद॑सी"
  ],
  "lines_iast": [
   "bṛ̱hadṷ gāyiṣe̱ vaco̭'su̱ryā̭ na̱dīnā̭m",
   "sara̭svatī̱minma̭hayā suvṛ̱ktibhi̱: stomai̭rvasiṣṭha̱ roda̭sī"
  ],
  "book_split": [
   "",

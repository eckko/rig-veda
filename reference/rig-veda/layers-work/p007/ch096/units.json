  "lines_deva": [
   "पी॒पि॒वांसं॒ सर॑स्वत॒: स्तनं॒ यो वि॒श्वद॑र्शतः । भ॒क्षी॒महि॑ प्र॒जामिष॑म्"
  ],
  "lines_iast": [
   "pī̱pi̱vāṃsa̱ṃ sara̭svata̱: stana̱ṃ yo vi̱śvada̭rśataḥ | bha̱kṣī̱mahi̭ pra̱jāmiṣa̭m"
  ],

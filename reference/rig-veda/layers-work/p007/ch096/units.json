  "lines_deva": [
   "ज॒नी॒यन्तो॒ न्वग्र॑वः पुत्री॒यन्त॑: सु॒दान॑वः । सर॑स्वन्तं हवामहे"
  ],
  "lines_iast": [
   "ja̱nī̱yanto̱ nvagra̭vaḥ putrī̱yanta̭: su̱dāna̭vaḥ | sara̭svantaṃ havāmahe"
  ],
  "book_split": [

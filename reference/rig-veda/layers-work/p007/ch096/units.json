 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.096.2a",
   "007.096.2b"
  ],
  "lines_deva": [
   "उ॒भे यत्ते॑ महि॒ना शु॑भ्रे॒ अन्ध॑सी अधिक्षि॒यन्ति॑ पू॒रव॑:",
   "सा नो॑ बोध्यवि॒त्री म॒रुत्स॑खा॒ चोद॒ राधो॑ म॒घोना॑म्"
  ],
  "lines_iast": [
   "u̱bhe yattḙ mahi̱nā śṷbhre̱ andha̭sī adhikṣi̱yanti̭ pū̱rava̭:",
   "sā no̭ bodhyavi̱trī ma̱rutsa̭khā̱ coda̱ rādho̭ ma̱ghonā̭m"
  ],
  "book_split": [

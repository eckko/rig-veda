  ],
  "lines_deva": [
   "ये ते॑ सरस्व ऊ॒र्मयो॒ मधु॑मन्तो घृत॒श्चुत॑: । तेभि॑र्नोऽवि॒ता भ॑व"
  ],
  "lines_iast": [
   "ye tḙ sarasva ū̱rmayo̱ madhṷmanto ghṛta̱ścuta̭: | tebhi̭rno'vi̱tā bha̭va"
  ],

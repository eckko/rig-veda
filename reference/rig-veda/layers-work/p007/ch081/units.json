   "007.081.3b"
  ],
  "lines_deva": [
   "प्रति॑ त्वा दुहितर्दिव॒ उषो॑ जी॒रा अ॑भुत्स्महि",
   "या वह॑सि पु॒रु स्पा॒र्हं व॑नन्वति॒ रत्नं॒ न दा॒शुषे॒ मय॑:"
  ],
  "lines_iast": [
   "prati̭ tvā duhitardiva̱ uṣo̭ jī̱rā a̭bhutsmahi",
   "yā vaha̭si pu̱ru spā̱rhaṃ va̭nanvati̱ ratna̱ṃ na dā̱śuṣe̱ maya̭:"
  ],

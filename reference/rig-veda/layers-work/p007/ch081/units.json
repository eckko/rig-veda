  "lines_deva": [
   "श्रव॑: सू॒रिभ्यो॑ अ॒मृतं॑ वसुत्व॒नं वाजाँ॑ अ॒स्मभ्यं॒ गोम॑तः",
   "चो॒द॒यि॒त्री म॒घोन॑: सू॒नृता॑वत्यु॒षा उ॑च्छ॒दप॒ स्रिध॑:"
  ],
  "lines_iast": [
   "śrava̭: sū̱ribhyo̭ a̱mṛta̭ṃ vasutva̱naṃ vājā̭~ a̱smabhya̱ṃ goma̭taḥ",
   "co̱da̱yi̱trī ma̱ghona̭: sū̱nṛtā̭vatyu̱ṣā ṷccha̱dapa̱ sridha̭:"
  ],

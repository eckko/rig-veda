  "lines_deva": [
   "प्रत्यु॑ अदर्श्याय॒त्यु१च्छन्ती॑ दुहि॒ता दि॒वः",
   "अपो॒ महि॑ व्ययति॒ चक्ष॑से॒ तमो॒ ज्योति॑ष्कृणोति सू॒नरी॑"
  ],
  "lines_iast": [
   "pratyṷ adarśyāya̱tyu1cchantī̭ duhi̱tā di̱vaḥ",
   "apo̱ mahi̭ vyayati̱ cakṣa̭se̱ tamo̱ jyoti̭ṣkṛṇoti sū̱narī̭"
  ],

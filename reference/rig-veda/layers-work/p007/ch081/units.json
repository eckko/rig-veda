  "lines_deva": [
   "उदु॒स्रिया॑: सृजते॒ सूर्य॒: सचाँ॑ उ॒द्यन्नक्ष॑त्रमर्चि॒वत्",
   "तवेदु॑षो॒ व्युषि॒ सूर्य॑स्य च॒ सं भ॒क्तेन॑ गमेमहि"
  ],
  "lines_iast": [
   "udu̱sriyā̭: sṛjate̱ sūrya̱: sacā̭~ u̱dyannakṣa̭tramarci̱vat",
   "tavedṷṣo̱ vyuṣi̱ sūrya̭sya ca̱ saṃ bha̱ktena̭ gamemahi"
  ],

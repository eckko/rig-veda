  "lines_deva": [
   "तच्चि॒त्रं राध॒ आ भ॒रोषो॒ यद्दी॑र्घ॒श्रुत्त॑मम्",
   "यत्ते॑ दिवो दुहितर्मर्त॒भोज॑नं॒ तद्रा॑स्व भु॒नजा॑महै"
  ],
  "lines_iast": [
   "tacci̱traṃ rādha̱ ā bha̱roṣo̱ yaddī̭rgha̱śrutta̭mam",
   "yattḙ divo duhitarmarta̱bhoja̭na̱ṃ tadrā̭sva bhu̱najā̭mahai"
  ],

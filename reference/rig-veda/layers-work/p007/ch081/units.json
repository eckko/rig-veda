   "007.081.4b"
  ],
  "lines_deva": [
   "उ॒च्छन्ती॒ या कृ॒णोषि॑ मं॒हना॑ महि प्र॒ख्यै दे॑वि॒ स्व॑र्दृ॒शे",
   "तस्या॑स्ते रत्न॒भाज॑ ईमहे व॒यं स्याम॑ मा॒तुर्न सू॒नव॑:"
  ],
  "lines_iast": [
   "u̱cchantī̱ yā kṛ̱ṇoṣi̭ ma̱ṃhanā̭ mahi pra̱khyai dḙvi̱ sva̭rdṛ̱śe",
   "tasyā̭ste ratna̱bhāja̭ īmahe va̱yaṃ syāma̭ mā̱turna sū̱nava̭:"
  ],
